{
  "id": "registry/end-event-of-unknown-launch-is-ignored",
  "title": "an end event whose launch line was never written does not create a launch",
  "source": [
    "cli/jitso/log.test.ts: 'events whose launch was never written are not turned into launches'"
  ],
  "project": {
    "files": {
      ".jitso/launches.jsonl": "{\"v\":1,\"event\":\"end\",\"id\":\"L20261113T142233-a3f9\",\"ts\":\"2026-11-13T14:30:00.000Z\",\"source\":\"reap\",\"outcome_reported\":\"none\",\"footer_path\":null}\n"
    }
  },
  "orca": {
    "listed": []
  },
  "steps": [
    {
      "run": [
        "close",
        "L20261113T142233-a3f9"
      ],
      "expect": {
        "exit": 2,
        "stderr": [
          "unknown launch"
        ],
        "orca_calls": {
          "empty": true
        }
      }
    },
    {
      "run": [
        "reap"
      ],
      "expect": {
        "exit": 0,
        "stdout": [
          "0 launch(es) marked ended"
        ],
        "registry": {
          "count": 1
        }
      }
    }
  ]
}
