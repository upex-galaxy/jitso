{
  "id": "launch/direct/worktree-is-forwarded-to-terminal-create",
  "title": "--worktree in direct mode goes to terminal create only, and the registry records it",
  "tags": [
    "posix"
  ],
  "source": [
    "cli/jitso/orca.test.ts: 'createTerminal passes worktree, title and command'"
  ],
  "project": {
    "files": {
      ".jitso/briefs/brief.md": {
        "from": "brief.md"
      }
    }
  },
  "steps": [
    {
      "run": [
        "launch",
        "--build",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/brief.md",
        "--mode",
        "direct",
        "--worktree",
        "id:fake-uuid::{{PROJECT}}"
      ],
      "capture": {
        "LAUNCH_ID": {
          "from": "stdout",
          "regex": "JITSO (L\\d{8}T\\d{6}-[0-9a-f]{4})",
          "group": 1
        }
      },
      "expect": {
        "exit": 0,
        "orca_calls": {
          "verbs": [
            "terminal create",
            "terminal wait",
            "terminal read"
          ],
          "calls": [
            {
              "at": 0,
              "argv": [
                "terminal",
                "create",
                "--worktree",
                "id:fake-uuid::{{PROJECT}}",
                "--title",
                "[jitso:{{LAUNCH_ID}}] haiku-explorer",
                "--command",
                "'{{PROJECT}}/.jitso/launches/{{LAUNCH_ID}}/run.sh'"
              ]
            }
          ],
          "none": [
            "orchestration worker-start"
          ]
        },
        "registry": {
          "count": 1,
          "events": [
            {
              "at": 0,
              "event": "launch",
              "fields": {
                "worktree": "id:fake-uuid::{{PROJECT}}"
              }
            }
          ]
        }
      }
    }
  ]
}
