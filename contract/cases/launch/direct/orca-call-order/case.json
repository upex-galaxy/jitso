{
  "id": "launch/direct/orca-call-order",
  "title": "a direct launch calls terminal create, terminal wait and one terminal read, in that order, and no orchestration verb",
  "source": [
    "cli/jitso/launch.test.ts: 'calls terminal create, wait and the trust read, never worker-start, and writes the artifacts'",
    "cli/jitso/launch.test.ts: '--command is the quoted absolute path of run.sh and the title carries the mark'",
    "cli/jitso/orca.test.ts: createTerminal / waitIdle / readScreen argv"
  ],
  "project": {
    "files": {
      ".jitso/briefs/brief.md": {
        "from": "brief.md"
      }
    }
  },
  "steps": [
    {
      "run": [
        "launch",
        "--preset",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/brief.md",
        "--mode",
        "direct"
      ],
      "capture": {
        "LAUNCH_ID": {
          "from": "stdout",
          "regex": "JITSO (L\\d{8}T\\d{6}-[0-9a-f]{4})",
          "group": 1
        }
      },
      "expect": {
        "exit": 0,
        "stderr": [
          {
            "empty": true
          }
        ],
        "orca_calls": {
          "verbs": [
            "terminal create",
            "terminal wait",
            "terminal read"
          ],
          "calls": [
            {
              "at": 0,
              "argv": [
                "terminal",
                "create",
                "--title",
                "[jitso:{{LAUNCH_ID}}] haiku-explorer",
                "--command",
                "'{{PROJECT}}/.jitso/launches/{{LAUNCH_ID}}/run.sh'"
              ]
            },
            {
              "at": 1,
              "argv": [
                "terminal",
                "wait",
                "--terminal",
                "term_fake",
                "--for",
                "tui-idle",
                "--timeout-ms",
                "90000"
              ]
            },
            {
              "at": 2,
              "argv": [
                "terminal",
                "read",
                "--terminal",
                "term_fake",
                "--screen"
              ]
            }
          ],
          "none": [
            "orchestration worker-start",
            "terminal send",
            "terminal close"
          ]
        }
      }
    }
  ]
}
