{
  "id": "launch/direct/brief-from-the-dispatcher-briefs-folder",
  "title": "a real launch accepts a brief from the dispatcher briefs folder and writes its launch folder under the project .jitso",
  "source": [
    "cli/jitso/launch.test.ts: allowedBriefDirs",
    "cli/jitso/index.ts: defaultDeps allowedBriefDirs"
  ],
  "home": {
    "files": {
      ".jitso/dispatch-cwd/briefs/brief.md": {
        "from": "brief.md"
      }
    }
  },
  "steps": [
    {
      "run": [
        "launch",
        "--preset",
        "haiku-explorer",
        "--brief",
        "{{HOME}}/.jitso/dispatch-cwd/briefs/brief.md",
        "--mode",
        "direct"
      ],
      "capture": {
        "LAUNCH_ID": {
          "from": "stdout",
          "regex": "JITSO (L\\d{8}T\\d{6}-[0-9a-f]{4})",
          "group": 1
        },
        "CARD": {
          "from": "stdout",
          "regex": "(?s)^(.*)\\n$",
          "group": 1
        }
      },
      "expect": {
        "exit": 0,
        "files": [
          {
            "path": ".jitso/launches/{{LAUNCH_ID}}/brief.md",
            "contains": [
              "{{CARD}}\n\n## Goal"
            ]
          }
        ],
        "registry": {
          "count": 1,
          "events": [
            {
              "at": 0,
              "event": "launch",
              "fields": {
                "brief_path": "{{PROJECT}}/.jitso/launches/{{LAUNCH_ID}}/brief.md"
              }
            }
          ]
        }
      }
    }
  ]
}
