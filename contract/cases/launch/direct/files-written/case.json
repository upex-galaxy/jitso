{
  "id": "launch/direct/files-written",
  "title": "a real launch writes brief.md (card, brief, then the JITSO rules), mcp.json, an executable run.sh and card.txt under .jitso/launches/<id>/ and no core.md",
  "tags": [
    "posix"
  ],
  "source": [
    "cli/jitso/launch.test.ts: 'calls terminal create, wait and the trust read, never worker-start, and writes the artifacts'",
    "intended: docs/architecture.md section 7 (S1): the card grows from five lines to six"
  ],
  "defect": "S1",
  "intent": "INTENDED behavior (defect S1, route_scope; docs/architecture.md section 7). The card printed by a real launch has six lines (header, model, subagents, a `ROUTE-SCOPE: <ids>` line of its own, launch, budget). The card header in brief.md ends `| build <id> v<n>` (build vocabulary, defect N-10; docs/decisions.md D6).",
  "project": {
    "files": {
      ".jitso/briefs/brief.md": {
        "from": "brief.md"
      }
    }
  },
  "steps": [
    {
      "run": [
        "launch",
        "--build",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/brief.md",
        "--mode",
        "direct"
      ],
      "capture": {
        "LAUNCH_ID": {
          "from": "stdout",
          "regex": "JITSO (L\\d{8}T\\d{6}-[0-9a-f]{4})",
          "group": 1
        },
        "CARD": {
          "from": "stdout",
          "regex": "(?s)^(.*)\\n$",
          "group": 1
        }
      },
      "expect": {
        "exit": 0,
        "stdout": [
          {
            "line_count": 6
          },
          {
            "regex": "^JITSO L\\d{8}T\\d{6}-[0-9a-f]{4} \\| operator/explorer \\| mode direct"
          }
        ],
        "stderr": [
          {
            "empty": true
          }
        ],
        "files": [
          {
            "path": ".jitso/launches/{{LAUNCH_ID}}/brief.md",
            "regex": [
              "^JITSO {{LAUNCH_ID}} \\| operator/explorer \\| mode direct \\(asks you\\) \\| build haiku-explorer v1 \\| name haiku-explorer\\n"
            ],
            "contains": [
              "{{CARD}}\n\n## Goal",
              "## Report format"
            ],
            "not_contains": [
              "Load first"
            ]
          },
          {
            "path": ".jitso/launches/{{LAUNCH_ID}}/core.md",
            "exists": false
          },
          {
            "path": ".jitso/launches/{{LAUNCH_ID}}/mcp.json",
            "equals": "{\n  \"mcpServers\": {}\n}\n"
          },
          {
            "path": ".jitso/launches/{{LAUNCH_ID}}/run.sh",
            "exists": true,
            "executable": true,
            "regex": [
              "^#!/bin/sh\\n",
              "\\nexec "
            ]
          },
          {
            "path": ".jitso/launches/{{LAUNCH_ID}}/card.txt",
            "equals": "{{CARD}}\n"
          }
        ]
      }
    }
  ]
}
