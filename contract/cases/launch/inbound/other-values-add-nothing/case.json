{
  "id": "launch/inbound/other-values-add-nothing",
  "title": "a user settings file without crossSessionInbound, or with any other value, adds nothing to --settings and prints nothing",
  "source": [
    "intended: docs/decisions.md, release 3 of the communication plan"
  ],
  "tags": [
    "posix"
  ],
  "for_each": {
    "vars": [
      "content"
    ],
    "rows": [
      [
        "{\"model\":\"sentinel-model\",\"env\":{\"OWNER_TOKEN\":\"sentinel-env\"},\"permissions\":{\"defaultMode\":\"sentinel-mode\"},\"hooks\":{\"sentinel-hook\":[]},\"apiKeyHelper\":\"sentinel-helper\",\"crossSessionInbound\":\"ask\"}"
      ],
      [
        "{\"model\":\"sentinel-model\",\"env\":{\"OWNER_TOKEN\":\"sentinel-env\"},\"permissions\":{\"defaultMode\":\"sentinel-mode\"},\"hooks\":{\"sentinel-hook\":[]},\"apiKeyHelper\":\"sentinel-helper\",\"crossSessionInbound\":\"Accept\"}"
      ],
      [
        "{\"model\":\"sentinel-model\",\"env\":{\"OWNER_TOKEN\":\"sentinel-env\"},\"permissions\":{\"defaultMode\":\"sentinel-mode\"},\"hooks\":{\"sentinel-hook\":[]},\"apiKeyHelper\":\"sentinel-helper\",\"crossSessionInbound\":\" accept\"}"
      ],
      [
        "{\"model\":\"sentinel-model\",\"env\":{\"OWNER_TOKEN\":\"sentinel-env\"},\"permissions\":{\"defaultMode\":\"sentinel-mode\"},\"hooks\":{\"sentinel-hook\":[]},\"apiKeyHelper\":\"sentinel-helper\",\"crossSessionInbound\":\"\"}"
      ],
      [
        "{\"model\":\"sentinel-model\",\"env\":{\"OWNER_TOKEN\":\"sentinel-env\"},\"permissions\":{\"defaultMode\":\"sentinel-mode\"},\"hooks\":{\"sentinel-hook\":[]},\"apiKeyHelper\":\"sentinel-helper\",\"crossSessionInbound\":true}"
      ],
      [
        "{\"model\":\"sentinel-model\",\"env\":{\"OWNER_TOKEN\":\"sentinel-env\"},\"permissions\":{\"defaultMode\":\"sentinel-mode\"},\"hooks\":{\"sentinel-hook\":[]},\"apiKeyHelper\":\"sentinel-helper\",\"crossSessionInbound\":null}"
      ],
      [
        "{\"model\":\"sentinel-model\",\"env\":{\"OWNER_TOKEN\":\"sentinel-env\"},\"permissions\":{\"defaultMode\":\"sentinel-mode\"},\"hooks\":{\"sentinel-hook\":[]},\"apiKeyHelper\":\"sentinel-helper\",\"crossSessionInbound\":[\"accept\"]}"
      ],
      [
        "{\"model\":\"sentinel-model\",\"env\":{\"OWNER_TOKEN\":\"sentinel-env\"},\"permissions\":{\"defaultMode\":\"sentinel-mode\"},\"hooks\":{\"sentinel-hook\":[]},\"apiKeyHelper\":\"sentinel-helper\",\"crossSessionInbound\":{\"sentinel-key\":\"accept\"}}"
      ],
      [
        "{\"env\":{\"OWNER_TOKEN\":\"sentinel-env\"},\"CrossSessionInbound\":\"accept\",\"nested\":{\"crossSessionInbound\":\"accept\"}}"
      ],
      [
        "[\"crossSessionInbound\",\"accept\"]"
      ],
      [
        "\"accept\""
      ]
    ],
    "ids": [
      "another-word",
      "other-case",
      "padded",
      "empty-string",
      "boolean",
      "null",
      "list",
      "object",
      "no-key",
      "top-level-list",
      "top-level-string"
    ]
  },
  "project": {
    "files": {
      ".jitso/briefs/brief.md": {
        "from": "brief.md"
      }
    }
  },
  "home": {
    "files": {
      ".claude/settings.json": "{{content}}"
    }
  },
  "steps": [
    {
      "run": [
        "launch",
        "--build",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/brief.md",
        "--mode",
        "direct"
      ],
      "capture": {
        "LAUNCH_ID": {
          "from": "stdout",
          "regex": "JITSO (L\\d{8}T\\d{6}-[0-9a-f]{4})"
        }
      },
      "expect": {
        "exit": 0,
        "stderr": [
          {
            "empty": true
          }
        ],
        "stdout": [
          {
            "not_contains": "sentinel"
          }
        ],
        "files": [
          {
            "path": ".jitso/launches.jsonl",
            "not_contains": [
              "crossSessionInbound",
              "sentinel"
            ]
          }
        ]
      }
    },
    {
      "exec": "run_sh",
      "launch": "{{LAUNCH_ID}}",
      "expect": {
        "exit": 0,
        "claude": {
          "ran": true,
          "argv_count": {
            "--settings": 1
          },
          "json_arg_after": {
            "--settings": [
              {
                "path": "",
                "keys_exact": [
                  "skipDangerousModePermissionPrompt",
                  "promptSuggestionEnabled",
                  "hooks"
                ]
              }
            ]
          }
        }
      }
    }
  ]
}
