{
  "id": "launch/name/explicit-name",
  "title": "launch --name <name> names the session: tab title, claude --name, card and launch event",
  "source": [
    "intended: docs/decisions.md, release 3 of the communication plan"
  ],
  "intent": "A name is 1 to 64 letters, digits, dot, dash or underscore and starts with a letter or digit; two dots in a row are fine, because a name is never a path.",
  "tags": [
    "posix"
  ],
  "for_each": {
    "var": "name",
    "values": [
      "Rev.1_x-Y",
      "a..b",
      "9",
      "n234567890123456789012345678901234567890123456789012345678901234"
    ],
    "ids": [
      "mixed",
      "two-dots",
      "one-digit",
      "sixty-four"
    ]
  },
  "project": {
    "files": {
      ".jitso/briefs/brief.md": {
        "from": "brief.md"
      }
    }
  },
  "steps": [
    {
      "run": [
        "launch",
        "--build",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/brief.md",
        "--mode",
        "direct",
        "--name",
        "{{name}}"
      ],
      "capture": {
        "LAUNCH_ID": {
          "from": "stdout",
          "regex": "JITSO (L\\d{8}T\\d{6}-[0-9a-f]{4})"
        }
      },
      "expect": {
        "exit": 0,
        "stderr": [
          {
            "empty": true
          }
        ],
        "stdout": [
          {
            "contains": "| build haiku-explorer v1 | name {{name}}\n"
          }
        ],
        "orca_calls": {
          "calls": [
            {
              "at": 0,
              "argv": [
                "terminal",
                "create",
                "--title",
                "{{name}} [jitso:{{LAUNCH_ID}}]",
                "--command",
                {
                  "regex": "run\\.sh'$"
                }
              ]
            }
          ]
        },
        "registry": {
          "count": 1,
          "events": [
            {
              "at": 0,
              "event": "launch",
              "fields": {
                "name": "{{name}}",
                "build": "haiku-explorer",
                "orca.title": "{{name}} [jitso:{{LAUNCH_ID}}]"
              }
            }
          ]
        }
      }
    },
    {
      "exec": "run_sh",
      "launch": "{{LAUNCH_ID}}",
      "expect": {
        "exit": 0,
        "claude": {
          "arg_after": {
            "--name": "{{name}}"
          },
          "argv_count": {
            "--name": 1
          }
        }
      }
    }
  ]
}
