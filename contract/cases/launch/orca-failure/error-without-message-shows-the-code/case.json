{
  "id": "launch/orca-failure/error-without-message-shows-the-code",
  "title": "an Orca error with a code and no message shows the code; no launch folder is left behind",
  "tags": [
    "posix"
  ],
  "source": [
    "cli/jitso/orca.ts: String(body.message ?? code ?? 'unknown error')",
    "intended: owner decision 2026-11-15: a failed launch leaves no launch folder"
  ],
  "defect": "N-2",
  "intent": "INTENDED behavior (owner decision 2026-11-15, defect N-2). A launch that fails before its registry line leaves no launch folder behind: the implementation removes .jitso/launches/<id>/ when the launch fails. The exit code, the stderr text, the empty registry and the orca calls are unchanged.",
  "project": {
    "files": {
      ".jitso/briefs/brief.md": {
        "from": "brief.md"
      }
    }
  },
  "orca": {
    "errors": {
      "terminal create": {
        "code": "only_code"
      }
    }
  },
  "steps": [
    {
      "run": [
        "launch",
        "--build",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/brief.md",
        "--mode",
        "direct"
      ],
      "expect": {
        "exit": 3,
        "stdout": [
          {
            "empty": true
          }
        ],
        "stderr": [
          {
            "contains": "jitso: orca terminal create failed: only_code"
          }
        ],
        "registry": {
          "count": 0
        },
        "orca_calls": {
          "verbs": [
            "terminal create"
          ]
        },
        "files": [
          {
            "path": ".jitso/launches/{{LAUNCH_ID}}",
            "exists": false
          }
        ]
      },
      "capture": {
        "LAUNCH_ID": {
          "from": "orca_log",
          "regex": "\\[jitso:(L\\d{8}T\\d{6}-[0-9a-f]{4})\\]"
        }
      }
    }
  ]
}
