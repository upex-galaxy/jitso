{
  "id": "launch/settings/project-env-covering-all-variables-cuts-env",
  "title": "when the project env defines every variable of the owner env, the env key is cut, not sent empty",
  "source": [
    "intended: docs/decisions.md, section Meant for v0.10.0"
  ],
  "tags": [
    "posix"
  ],
  "project": {
    "files": {
      ".jitso/briefs/brief.md": {
        "from": "brief.md"
      },
      ".claude/settings.json": "{\"env\":{\"A\":\"p\",\"B\":\"p\"}}"
    }
  },
  "home": {
    "files": {
      ".claude/settings.json": "{\"env\":{\"A\":\"sentinel-a\",\"B\":\"sentinel-b\"}}"
    }
  },
  "steps": [
    {
      "run": [
        "launch",
        "--build",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/brief.md",
        "--mode",
        "direct"
      ],
      "capture": {
        "LAUNCH_ID": {
          "from": "stdout",
          "regex": "JITSO (L\\d{8}T\\d{6}-[0-9a-f]{4})"
        }
      },
      "expect": {
        "exit": 0,
        "stderr": [
          {
            "empty": true
          }
        ],
        "stdout": [
          {
            "not_contains": "sentinel"
          }
        ],
        "files": [
          {
            "path": ".jitso/launches/{{LAUNCH_ID}}/run.sh",
            "not_contains": [
              "sentinel"
            ]
          },
          {
            "path": ".jitso/launches/{{LAUNCH_ID}}/brief.md",
            "not_contains": [
              "sentinel"
            ]
          },
          {
            "path": ".jitso/launches/{{LAUNCH_ID}}/card.txt",
            "not_contains": [
              "sentinel"
            ]
          },
          {
            "path": ".jitso/launches.jsonl",
            "not_contains": [
              "sentinel"
            ]
          }
        ],
        "registry": {
          "count": 1,
          "events": [
            {
              "at": 0,
              "event": "launch",
              "fields": {
                "settings.copied": [],
                "settings.cut": [
                  "env"
                ]
              }
            }
          ]
        }
      }
    },
    {
      "exec": "run_sh",
      "launch": "{{LAUNCH_ID}}",
      "expect": {
        "exit": 0,
        "claude": {
          "ran": true,
          "argv_count": {
            "--settings": 1
          },
          "arg_after": {
            "--settings": "{{PROJECT}}/.jitso/launches/{{LAUNCH_ID}}/settings.json"
          },
          "json_file_after": {
            "--settings": [
              {
                "path": "",
                "keys_exact": [
                  "skipDangerousModePermissionPrompt",
                  "promptSuggestionEnabled",
                  "hooks"
                ]
              },
              {
                "path": "skipDangerousModePermissionPrompt",
                "equals": true
              },
              {
                "path": "promptSuggestionEnabled",
                "equals": false
              },
              {
                "path": "hooks.PreToolUse.0.matcher",
                "equals": "Bash"
              }
            ]
          }
        }
      }
    }
  ]
}
