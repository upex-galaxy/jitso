{
  "id": "launch/settings/user-guard-removed-when-project-registers-it",
  "title": "when the project registers the guard itself the launch carries none, and the guard handlers of the owner hooks are still removed, so hooks is left out when nothing else is in it",
  "source": [
    "intended: docs/decisions.md, section Meant for v0.10.0"
  ],
  "tags": [
    "posix"
  ],
  "project": {
    "files": {
      ".jitso/briefs/brief.md": {
        "from": "brief.md"
      },
      ".claude/settings.json": {
        "from": "settings.json"
      }
    }
  },
  "home": {
    "files": {
      ".claude/settings.json": "{\"hooks\":{\"SessionEnd\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"jitso hook guard\"}]}]}}"
    }
  },
  "steps": [
    {
      "run": [
        "launch",
        "--build",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/brief.md",
        "--mode",
        "direct"
      ],
      "capture": {
        "LAUNCH_ID": {
          "from": "stdout",
          "regex": "JITSO (L\\d{8}T\\d{6}-[0-9a-f]{4})"
        }
      },
      "expect": {
        "exit": 0,
        "stderr": [
          {
            "empty": true
          }
        ],
        "files": [],
        "registry": {
          "count": 1,
          "events": [
            {
              "at": 0,
              "event": "launch",
              "fields": {
                "settings.copied": [],
                "settings.cut": [
                  "hooks"
                ]
              }
            }
          ]
        }
      }
    },
    {
      "exec": "run_sh",
      "launch": "{{LAUNCH_ID}}",
      "expect": {
        "exit": 0,
        "claude": {
          "ran": true,
          "argv_count": {
            "--settings": 1
          },
          "arg_after": {
            "--settings": "{{PROJECT}}/.jitso/launches/{{LAUNCH_ID}}/settings.json"
          },
          "json_file_after": {
            "--settings": [
              {
                "path": "",
                "keys_exact": [
                  "skipDangerousModePermissionPrompt",
                  "promptSuggestionEnabled"
                ]
              }
            ]
          }
        }
      }
    }
  ]
}
