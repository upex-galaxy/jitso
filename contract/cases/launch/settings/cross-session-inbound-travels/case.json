{
  "id": "launch/settings/cross-session-inbound-travels",
  "title": "crossSessionInbound of the owner user settings travels like any other key, whatever its value, so the owner choice about messages from other sessions reaches the worker",
  "source": [
    "intended: docs/decisions.md, section Meant for v0.10.0"
  ],
  "intent": "Replaces the v0.9.0 cases that read only this key and only accept, hold or refuse.",
  "tags": [
    "posix"
  ],
  "for_each": {
    "var": "value",
    "values": [
      "accept",
      "hold",
      "refuse",
      "ask"
    ],
    "ids": [
      "accept",
      "hold",
      "refuse",
      "other-word"
    ]
  },
  "project": {
    "files": {
      ".jitso/briefs/brief.md": {
        "from": "brief.md"
      }
    }
  },
  "home": {
    "files": {
      ".claude/settings.json": "{\"crossSessionInbound\":\"{{value}}\"}"
    }
  },
  "steps": [
    {
      "run": [
        "launch",
        "--build",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/brief.md",
        "--mode",
        "direct"
      ],
      "capture": {
        "LAUNCH_ID": {
          "from": "stdout",
          "regex": "JITSO (L\\d{8}T\\d{6}-[0-9a-f]{4})"
        }
      },
      "expect": {
        "exit": 0,
        "stderr": [
          {
            "empty": true
          }
        ],
        "stdout": [
          {
            "contains": "settings copied: crossSessionInbound | cut: none"
          }
        ],
        "registry": {
          "count": 1,
          "events": [
            {
              "at": 0,
              "event": "launch",
              "fields": {
                "settings.copied": [
                  "crossSessionInbound"
                ],
                "settings.cut": []
              }
            }
          ]
        }
      }
    },
    {
      "exec": "run_sh",
      "launch": "{{LAUNCH_ID}}",
      "expect": {
        "exit": 0,
        "claude": {
          "ran": true,
          "argv_count": {
            "--settings": 1
          },
          "arg_after": {
            "--settings": "{{PROJECT}}/.jitso/launches/{{LAUNCH_ID}}/settings.json"
          },
          "json_file_after": {
            "--settings": [
              {
                "path": "",
                "keys_exact": [
                  "skipDangerousModePermissionPrompt",
                  "promptSuggestionEnabled",
                  "hooks",
                  "crossSessionInbound"
                ]
              },
              {
                "path": "crossSessionInbound",
                "equals": "{{value}}"
              },
              {
                "path": "skipDangerousModePermissionPrompt",
                "equals": true
              },
              {
                "path": "promptSuggestionEnabled",
                "equals": false
              },
              {
                "path": "hooks.PreToolUse.0.matcher",
                "equals": "Bash"
              }
            ]
          }
        }
      }
    }
  ]
}
