{
  "id": "launch/fleet/receipt-worker-object-is-recorded",
  "title": "the launch event records the Task id that the worker-start receipt names (worker object)",
  "tags": [
    "posix"
  ],
  "source": [
    "intended: docs/decisions.md, Pre-release fixes (JITSO creates the Orca Task in fleet mode)"
  ],
  "intent": "The worker-start receipt was not measured against a live Orca when this case was written: its shape is derived from the worker-list record, so the reader accepts the likely places of the id.",
  "project": {
    "files": {
      ".jitso/briefs/brief.md": {
        "from": "brief.md"
      }
    }
  },
  "orca": {
    "responses": {
      "orchestration worker-start": {
        "worker": {
          "taskId": "task_1"
        }
      }
    }
  },
  "steps": [
    {
      "run": [
        "launch",
        "--build",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/brief.md",
        "--mode",
        "fleet",
        "--run",
        "run_1"
      ],
      "capture": {
        "LAUNCH_ID": {
          "from": "stdout",
          "regex": "JITSO (L\\d{8}T\\d{6}-[0-9a-f]{4})",
          "group": 1
        }
      },
      "expect": {
        "exit": 0,
        "stderr": [
          {
            "empty": true
          }
        ],
        "registry": {
          "count": 1,
          "events": [
            {
              "at": 0,
              "event": "launch",
              "fields": {
                "orca.run": "run_1",
                "orca.task": "task_1"
              }
            }
          ]
        }
      }
    }
  ]
}
