{
  "id": "launch/fleet/worktree-is-forwarded-to-both-calls",
  "title": "--worktree is passed to terminal create (before --title) and to orchestration worker-start (last)",
  "source": [
    "cli/jitso/launch.test.ts: 'adopts the terminal with worker-start --terminal --worktree'",
    "cli/jitso/orca.test.ts: 'createTerminal passes worktree, title and command'"
  ],
  "project": {
    "files": {
      ".jitso/briefs/brief.md": {
        "from": "brief.md"
      }
    }
  },
  "steps": [
    {
      "run": [
        "launch",
        "--build",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/brief.md",
        "--mode",
        "fleet",
        "--run",
        "run_1",
        "--task",
        "task_1",
        "--worktree",
        "id:fake-uuid::/fake/cwd"
      ],
      "capture": {
        "LAUNCH_ID": {
          "from": "stdout",
          "regex": "JITSO (L\\d{8}T\\d{6}-[0-9a-f]{4})",
          "group": 1
        }
      },
      "expect": {
        "exit": 0,
        "orca_calls": {
          "verbs": [
            "terminal create",
            "terminal wait",
            "terminal read",
            "orchestration worker-start"
          ],
          "calls": [
            {
              "at": 0,
              "argv": [
                "terminal",
                "create",
                "--worktree",
                "id:fake-uuid::/fake/cwd",
                "--title",
                "[jitso:{{LAUNCH_ID}}] haiku-explorer",
                "--command",
                "'{{PROJECT}}/.jitso/launches/{{LAUNCH_ID}}/run.sh'"
              ]
            },
            {
              "at": 1,
              "argv": [
                "terminal",
                "wait",
                "--terminal",
                "term_fake",
                "--for",
                "tui-idle",
                "--timeout-ms",
                "90000"
              ]
            },
            {
              "at": 2,
              "argv": [
                "terminal",
                "read",
                "--terminal",
                "term_fake",
                "--screen"
              ]
            },
            {
              "at": 3,
              "argv": [
                "orchestration",
                "worker-start",
                "--run",
                "run_1",
                "--task",
                "task_1",
                "--terminal",
                "term_fake",
                "--worktree",
                "id:fake-uuid::/fake/cwd"
              ]
            }
          ]
        },
        "registry": {
          "count": 1,
          "events": [
            {
              "at": 0,
              "event": "launch",
              "fields": {
                "worktree": "id:fake-uuid::/fake/cwd"
              }
            }
          ]
        }
      }
    }
  ]
}
