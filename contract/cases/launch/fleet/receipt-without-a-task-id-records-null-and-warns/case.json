{
  "id": "launch/fleet/receipt-without-a-task-id-records-null-and-warns",
  "title": "a worker-start receipt that names no Task id still registers the launch with a null task and a warning on stderr",
  "tags": [
    "posix"
  ],
  "source": [
    "intended: docs/decisions.md, Pre-release fixes (JITSO creates the Orca Task in fleet mode)"
  ],
  "project": {
    "files": {
      ".jitso/briefs/brief.md": {
        "from": "brief.md"
      }
    }
  },
  "orca": {
    "responses": {
      "orchestration worker-start": {
        "state": "ready"
      }
    }
  },
  "steps": [
    {
      "run": [
        "launch",
        "--build",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/brief.md",
        "--mode",
        "fleet",
        "--run",
        "run_1"
      ],
      "capture": {
        "LAUNCH_ID": {
          "from": "stdout",
          "regex": "JITSO (L\\d{8}T\\d{6}-[0-9a-f]{4})",
          "group": 1
        }
      },
      "expect": {
        "exit": 0,
        "stderr": [
          {
            "contains": "jitso: warning: orchestration worker-start returned no task id"
          }
        ],
        "registry": {
          "count": 1,
          "events": [
            {
              "at": 0,
              "event": "launch",
              "fields": {
                "orca.run": "run_1",
                "orca.task": null
              }
            }
          ]
        }
      }
    }
  ]
}
