{
  "id": "launch/trust/dialog-in-a-repo-worktree-is-confirmed",
  "title": "a trust dialog in the project folder gets arrow down then Enter, in that order, and the registry says handled",
  "tags": [
    "posix"
  ],
  "source": [
    "cli/jitso/trust.test.ts: 'a screen with the dialog gets arrow down then Enter, in that order, and reports handled'",
    "cli/jitso/launch.test.ts: 'dialog in a worktree of the primary repo: arrow down then Enter, event says handled'"
  ],
  "project": {
    "files": {
      ".jitso/briefs/brief.md": {
        "from": "brief.md"
      }
    }
  },
  "orca": {
    "screens": [
      "Is this a project you created or one you trust?\n 1. Yes, I trust this folder\n 2. No, exit",
      "❯ \n medium · /effort\n bypass permissions on"
    ]
  },
  "steps": [
    {
      "run": [
        "launch",
        "--build",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/brief.md",
        "--mode",
        "direct"
      ],
      "capture": {
        "LAUNCH_ID": {
          "from": "stdout",
          "regex": "JITSO (L\\d{8}T\\d{6}-[0-9a-f]{4})",
          "group": 1
        }
      },
      "expect": {
        "exit": 0,
        "orca_calls": {
          "verbs": [
            "terminal create",
            "terminal wait",
            "terminal read",
            "terminal send",
            "terminal send",
            "terminal read"
          ],
          "calls": [
            {
              "at": 0,
              "argv": [
                "terminal",
                "create",
                "--title",
                "[jitso:{{LAUNCH_ID}}] haiku-explorer",
                "--command",
                "'{{PROJECT}}/.jitso/launches/{{LAUNCH_ID}}/run.sh'"
              ]
            },
            {
              "at": 1,
              "argv": [
                "terminal",
                "wait",
                "--terminal",
                "term_fake",
                "--for",
                "tui-idle",
                "--timeout-ms",
                "90000"
              ]
            },
            {
              "at": 2,
              "argv": [
                "terminal",
                "read",
                "--terminal",
                "term_fake",
                "--screen"
              ]
            },
            {
              "at": 3,
              "argv": [
                "terminal",
                "send",
                "--terminal",
                "term_fake",
                "--text",
                "\u001b[B"
              ]
            },
            {
              "at": 4,
              "argv": [
                "terminal",
                "send",
                "--terminal",
                "term_fake",
                "--text",
                "\r"
              ]
            },
            {
              "at": 5,
              "argv": [
                "terminal",
                "read",
                "--terminal",
                "term_fake",
                "--screen"
              ]
            }
          ]
        },
        "registry": {
          "count": 1,
          "events": [
            {
              "at": 0,
              "event": "launch",
              "fields": {
                "trust_dialog": "handled"
              }
            }
          ]
        }
      }
    }
  ]
}
