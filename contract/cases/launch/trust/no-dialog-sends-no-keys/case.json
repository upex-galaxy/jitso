{
  "id": "launch/trust/no-dialog-sends-no-keys",
  "title": "a normal idle screen means trust_dialog absent and no key is sent",
  "tags": [
    "posix"
  ],
  "source": [
    "cli/jitso/trust.test.ts: 'a screen without the dialog gets no keys and reports absent'"
  ],
  "project": {
    "files": {
      ".jitso/briefs/brief.md": {
        "from": "brief.md"
      }
    }
  },
  "steps": [
    {
      "run": [
        "launch",
        "--build",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/brief.md",
        "--mode",
        "direct"
      ],
      "capture": {
        "LAUNCH_ID": {
          "from": "stdout",
          "regex": "JITSO (L\\d{8}T\\d{6}-[0-9a-f]{4})",
          "group": 1
        }
      },
      "expect": {
        "exit": 0,
        "orca_calls": {
          "none": [
            "terminal send"
          ],
          "count": 3
        },
        "registry": {
          "count": 1,
          "events": [
            {
              "at": 0,
              "event": "launch",
              "fields": {
                "trust_dialog": "absent"
              }
            }
          ]
        }
      }
    }
  ]
}
