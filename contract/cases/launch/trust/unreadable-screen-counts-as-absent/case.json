{
  "id": "launch/trust/unreadable-screen-counts-as-absent",
  "title": "a terminal read answer without a screen is an empty screen: absent, no keys, launch succeeds",
  "source": [
    "cli/jitso/orca.test.ts: 'readScreen joins the tail rows of the rendered screen' (empty tail)"
  ],
  "project": {
    "files": {
      ".jitso/briefs/brief.md": {
        "from": "brief.md"
      }
    }
  },
  "orca": {
    "responses": {
      "terminal read": {}
    }
  },
  "steps": [
    {
      "run": [
        "launch",
        "--preset",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/brief.md",
        "--mode",
        "direct"
      ],
      "capture": {
        "LAUNCH_ID": {
          "from": "stdout",
          "regex": "JITSO (L\\d{8}T\\d{6}-[0-9a-f]{4})",
          "group": 1
        }
      },
      "expect": {
        "exit": 0,
        "orca_calls": {
          "none": [
            "terminal send"
          ]
        },
        "registry": {
          "count": 1,
          "events": [
            {
              "at": 0,
              "event": "launch",
              "fields": {
                "trust_dialog": "absent"
              }
            }
          ]
        }
      }
    }
  ]
}
