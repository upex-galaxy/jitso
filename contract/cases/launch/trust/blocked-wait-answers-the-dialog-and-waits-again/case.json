{
  "id": "launch/trust/blocked-wait-answers-the-dialog-and-waits-again",
  "title": "when Orca answers the idle wait as blocked by the trust dialog (exit 1, ok true), the launch confirms the dialog in a repo worktree, waits once more and succeeds with trust_dialog handled",
  "tags": [
    "posix"
  ],
  "source": [
    "intended: found in the first real Orca run, Orca answers a trust dialog as a blocked wait"
  ],
  "project": {
    "files": {
      ".jitso/briefs/brief.md": {
        "from": "brief.md"
      }
    }
  },
  "orca": {
    "screens": [
      "Is this a project you created or one you trust?\n 1. Yes, I trust this folder\n 2. No, exit",
      "❯ \n medium · /effort\n bypass permissions on"
    ],
    "wait_blocked": [
      "agent-trust-workspace"
    ]
  },
  "steps": [
    {
      "run": [
        "launch",
        "--build",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/brief.md",
        "--mode",
        "direct"
      ],
      "capture": {
        "LAUNCH_ID": {
          "from": "stdout",
          "regex": "JITSO (L\\d{8}T\\d{6}-[0-9a-f]{4})",
          "group": 1
        }
      },
      "expect": {
        "exit": 0,
        "orca_calls": {
          "verbs": [
            "terminal create",
            "terminal wait",
            "terminal read",
            "terminal send",
            "terminal send",
            "terminal read",
            "terminal wait"
          ],
          "calls": [
            {
              "at": 0,
              "argv": [
                "terminal",
                "create",
                "--title",
                "haiku-explorer [jitso:{{LAUNCH_ID}}]",
                "--command",
                "'{{PROJECT}}/.jitso/launches/{{LAUNCH_ID}}/run.sh'"
              ]
            },
            {
              "at": 1,
              "argv": [
                "terminal",
                "wait",
                "--terminal",
                "term_fake",
                "--for",
                "tui-idle",
                "--timeout-ms",
                "90000"
              ]
            },
            {
              "at": 2,
              "argv": [
                "terminal",
                "read",
                "--terminal",
                "term_fake",
                "--screen"
              ]
            },
            {
              "at": 3,
              "argv": [
                "terminal",
                "send",
                "--terminal",
                "term_fake",
                "--text",
                "\u001b[B"
              ]
            },
            {
              "at": 4,
              "argv": [
                "terminal",
                "send",
                "--terminal",
                "term_fake",
                "--text",
                "\r"
              ]
            },
            {
              "at": 5,
              "argv": [
                "terminal",
                "read",
                "--terminal",
                "term_fake",
                "--screen"
              ]
            },
            {
              "at": 6,
              "argv": [
                "terminal",
                "wait",
                "--terminal",
                "term_fake",
                "--for",
                "tui-idle",
                "--timeout-ms",
                "90000"
              ]
            }
          ]
        },
        "registry": {
          "count": 1,
          "events": [
            {
              "at": 0,
              "event": "launch",
              "fields": {
                "trust_dialog": "handled"
              }
            }
          ]
        }
      }
    }
  ],
  "intent": "Measured on Orca 1.4.257: a terminal whose agent shows the trust dialog answers `terminal wait --for tui-idle` with exit 1 and ok:true, wait.satisfied false, blockedReason agent-trust-workspace. The launch must read that answer instead of the exit status, answer the dialog, then wait for idle a second time with the same timeout."
}
