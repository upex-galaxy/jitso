{
  "id": "launch/trust/dialog-text-variants-are-confirmed",
  "title": "the dialog is detected with the word trust in any case, anywhere on the screen",
  "source": [
    "cli/jitso/adapters/claude.ts: detect = /trust/i.test(screen) && screen.includes('No, exit')"
  ],
  "project": {
    "files": {
      ".jitso/briefs/brief.md": {
        "from": "brief.md"
      }
    }
  },
  "orca": {
    "screens": [
      "{{screen}}",
      "❯ \n medium · /effort\n bypass permissions on"
    ]
  },
  "for_each": {
    "var": "screen",
    "values": [
      "TRUST THIS FOLDER?\n 2. No, exit",
      "Trust\nNo, exit",
      "  Do you trust it? No, exit  "
    ]
  },
  "steps": [
    {
      "run": [
        "launch",
        "--build",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/brief.md",
        "--mode",
        "direct"
      ],
      "capture": {
        "LAUNCH_ID": {
          "from": "stdout",
          "regex": "JITSO (L\\d{8}T\\d{6}-[0-9a-f]{4})",
          "group": 1
        }
      },
      "expect": {
        "exit": 0,
        "orca_calls": {
          "calls": [
            {
              "at": 0,
              "argv": [
                "terminal",
                "create",
                "--title",
                "[jitso:{{LAUNCH_ID}}] haiku-explorer",
                "--command",
                "'{{PROJECT}}/.jitso/launches/{{LAUNCH_ID}}/run.sh'"
              ]
            },
            {
              "at": 1,
              "argv": [
                "terminal",
                "wait",
                "--terminal",
                "term_fake",
                "--for",
                "tui-idle",
                "--timeout-ms",
                "90000"
              ]
            },
            {
              "at": 2,
              "argv": [
                "terminal",
                "read",
                "--terminal",
                "term_fake",
                "--screen"
              ]
            },
            {
              "at": 3,
              "argv": [
                "terminal",
                "send",
                "--terminal",
                "term_fake",
                "--text",
                "\u001b[B"
              ]
            },
            {
              "at": 4,
              "argv": [
                "terminal",
                "send",
                "--terminal",
                "term_fake",
                "--text",
                "\r"
              ]
            }
          ]
        },
        "registry": {
          "count": 1,
          "events": [
            {
              "at": 0,
              "event": "launch",
              "fields": {
                "trust_dialog": "handled"
              }
            }
          ]
        }
      }
    }
  ]
}
