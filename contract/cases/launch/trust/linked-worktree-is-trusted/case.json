{
  "id": "launch/trust/linked-worktree-is-trusted",
  "title": "a dialog in a linked git worktree of the project gets the confirm keys",
  "source": [
    "cli/jitso/trust.test.ts: 'the primary checkout and a linked worktree are trusted'"
  ],
  "project": {
    "files": {
      ".jitso/briefs/brief.md": {
        "from": "brief.md"
      }
    }
  },
  "orca": {
    "screens": [
      "Is this a project you created or one you trust?\n 1. Yes, I trust this folder\n 2. No, exit",
      "❯ \n medium · /effort\n bypass permissions on"
    ],
    "cwd": "{{WORKTREE_linked}}"
  },
  "steps": [
    {
      "git_worktree": {
        "name": "linked"
      },
      "expect": {
        "files": [
          {
            "path": "{{WORKTREE_linked}}/.git",
            "exists": true
          }
        ]
      }
    },
    {
      "run": [
        "launch",
        "--preset",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/brief.md",
        "--mode",
        "direct"
      ],
      "capture": {
        "LAUNCH_ID": {
          "from": "stdout",
          "regex": "JITSO (L\\d{8}T\\d{6}-[0-9a-f]{4})",
          "group": 1
        }
      },
      "expect": {
        "exit": 0,
        "orca_calls": {
          "calls": [
            {
              "at": 0,
              "argv": [
                "terminal",
                "create",
                "--title",
                "[jitso:{{LAUNCH_ID}}] haiku-explorer",
                "--command",
                "'{{PROJECT}}/.jitso/launches/{{LAUNCH_ID}}/run.sh'"
              ]
            },
            {
              "at": 1,
              "argv": [
                "terminal",
                "wait",
                "--terminal",
                "term_fake",
                "--for",
                "tui-idle",
                "--timeout-ms",
                "90000"
              ]
            },
            {
              "at": 2,
              "argv": [
                "terminal",
                "read",
                "--terminal",
                "term_fake",
                "--screen"
              ]
            },
            {
              "at": 3,
              "argv": [
                "terminal",
                "send",
                "--terminal",
                "term_fake",
                "--text",
                "\u001b[B"
              ]
            },
            {
              "at": 4,
              "argv": [
                "terminal",
                "send",
                "--terminal",
                "term_fake",
                "--text",
                "\r"
              ]
            }
          ]
        },
        "registry": {
          "count": 1,
          "events": [
            {
              "at": 0,
              "event": "launch",
              "fields": {
                "trust_dialog": "handled",
                "cwd": "{{WORKTREE_linked}}"
              }
            }
          ]
        }
      }
    }
  ]
}
