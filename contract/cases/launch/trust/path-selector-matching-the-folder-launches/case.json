{
  "id": "launch/trust/path-selector-matching-the-folder-launches",
  "title": "a path: selector of a linked worktree that Orca honours launches: the folder check does not over-refuse",
  "source": [
    "intended: N-22 over-refusal guard: a path selector that Orca honours is not refused"
  ],
  "status": {
    "ts": "pass",
    "go": "pass"
  },
  "defect": "N-22",
  "intent": "Pins the allowed side of defect N-22: when --worktree names a linked worktree of the repo and Orca reports that same folder, the launch goes on, forwards the selector and records the folder. The TS binary forwards the selector and launches too, so this case passes on both.",
  "project": {
    "files": {
      ".jitso/briefs/brief.md": {
        "from": "brief.md"
      }
    }
  },
  "orca": {
    "cwd": "{{WORKTREE_linked}}"
  },
  "steps": [
    {
      "git_worktree": {
        "name": "linked"
      },
      "expect": {
        "files": [
          {
            "path": "{{WORKTREE_linked}}/.git",
            "exists": true
          }
        ]
      }
    },
    {
      "run": [
        "launch",
        "--build",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/brief.md",
        "--mode",
        "direct",
        "--worktree",
        "path:{{WORKTREE_linked}}"
      ],
      "capture": {
        "LAUNCH_ID": {
          "from": "stdout",
          "regex": "JITSO (L\\d{8}T\\d{6}-[0-9a-f]{4})",
          "group": 1
        }
      },
      "expect": {
        "exit": 0,
        "orca_calls": {
          "calls": [
            {
              "at": 0,
              "argv": [
                "terminal",
                "create",
                "--worktree",
                "path:{{WORKTREE_linked}}",
                "--title",
                "[jitso:{{LAUNCH_ID}}] haiku-explorer",
                "--command",
                "'{{PROJECT}}/.jitso/launches/{{LAUNCH_ID}}/run.sh'"
              ]
            }
          ],
          "none": [
            "terminal close"
          ]
        },
        "registry": {
          "count": 1,
          "events": [
            {
              "at": 0,
              "event": "launch",
              "fields": {
                "cwd": "{{WORKTREE_linked}}",
                "worktree": "path:{{WORKTREE_linked}}"
              }
            }
          ]
        }
      }
    }
  ]
}
