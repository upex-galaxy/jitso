{
  "id": "launch/trust/untrusted-folder-without-dialog-still-launches",
  "title": "an untrusted folder is only a problem when the dialog appears: without it the launch succeeds and records the folder",
  "source": [
    "cli/jitso/trust.test.ts: 'an untrusted folder without the dialog is simply absent'"
  ],
  "project": {
    "files": {
      ".jitso/briefs/brief.md": {
        "from": "brief.md"
      }
    }
  },
  "orca": {
    "cwd": "{{HOME}}/elsewhere"
  },
  "steps": [
    {
      "run": [
        "launch",
        "--build",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/brief.md",
        "--mode",
        "direct"
      ],
      "capture": {
        "LAUNCH_ID": {
          "from": "stdout",
          "regex": "JITSO (L\\d{8}T\\d{6}-[0-9a-f]{4})",
          "group": 1
        }
      },
      "expect": {
        "exit": 0,
        "orca_calls": {
          "none": [
            "terminal send",
            "terminal close"
          ]
        },
        "registry": {
          "count": 1,
          "events": [
            {
              "at": 0,
              "event": "launch",
              "fields": {
                "trust_dialog": "absent",
                "cwd": "{{HOME}}/elsewhere"
              }
            }
          ]
        }
      }
    }
  ]
}
