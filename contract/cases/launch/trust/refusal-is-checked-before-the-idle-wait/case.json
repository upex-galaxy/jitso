{
  "id": "launch/trust/refusal-is-checked-before-the-idle-wait",
  "title": "the folder check runs before terminal wait: a worker that never idles is still refused at once, exit 2 and not 3",
  "source": [
    "intended: owner decision, defect N-22: the folder Orca reports is checked on every launch"
  ],
  "defect": "N-22",
  "intent": "INTENDED behavior (owner decision, defect N-22). The folder check runs right after terminal create, before the idle wait, so the window in which a worker runs in the wrong folder is as short as the code can make it. With a terminal that never idles the launch is refused (exit 2), not reported as an idle timeout (exit 3).",
  "project": {
    "files": {
      ".jitso/briefs/brief.md": {
        "from": "brief.md"
      }
    }
  },
  "orca": {
    "cwd": "{{HOME}}/elsewhere",
    "wait_times_out": true
  },
  "steps": [
    {
      "run": [
        "launch",
        "--build",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/brief.md",
        "--mode",
        "direct"
      ],
      "capture": {
        "LAUNCH_ID": {
          "from": "orca_log",
          "regex": "\\[jitso:(L\\d{8}T\\d{6}-[0-9a-f]{4})\\]"
        }
      },
      "expect": {
        "exit": 2,
        "stdout": [
          {
            "empty": true
          }
        ],
        "stderr": [
          {
            "contains": "untrusted folder {{HOME}}/elsewhere"
          }
        ],
        "orca_calls": {
          "verbs": [
            "terminal create",
            "terminal close"
          ],
          "none": [
            "terminal wait",
            "terminal read"
          ]
        },
        "registry": {
          "count": 0
        },
        "files": [
          {
            "path": ".jitso/launches/{{LAUNCH_ID}}",
            "exists": false
          }
        ]
      }
    }
  ]
}
