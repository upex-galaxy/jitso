{
  "id": "launch/trust/id-selector-compares-its-path",
  "title": "an id:<id>::<path> selector names a path like path: does, and the folder Orca reports must equal it",
  "source": [
    "intended: owner decision, defect N-22: the folder Orca reports is checked on every launch"
  ],
  "defect": "N-22",
  "intent": "INTENDED behavior (owner decision, defect N-22). The id:<id>::<path> form is Orca's own worktreeId, so the text after the first :: is the path the caller asked for. Orca reporting another worktree is refused with the 'asked for' text.",
  "project": {
    "files": {
      ".jitso/briefs/brief.md": {
        "from": "brief.md"
      }
    }
  },
  "steps": [
    {
      "git_worktree": {
        "name": "linked"
      },
      "expect": {
        "files": [
          {
            "path": "{{WORKTREE_linked}}/.git",
            "exists": true
          }
        ]
      }
    },
    {
      "run": [
        "launch",
        "--build",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/brief.md",
        "--mode",
        "direct",
        "--worktree",
        "id:fake-uuid::{{WORKTREE_linked}}"
      ],
      "capture": {
        "LAUNCH_ID": {
          "from": "orca_log",
          "regex": "\\[jitso:(L\\d{8}T\\d{6}-[0-9a-f]{4})\\]"
        }
      },
      "expect": {
        "exit": 2,
        "stdout": [
          {
            "empty": true
          }
        ],
        "stderr": [
          {
            "contains": "--worktree asked for {{WORKTREE_linked}}"
          }
        ],
        "orca_calls": {
          "verbs": [
            "terminal create",
            "terminal close"
          ]
        },
        "registry": {
          "count": 0
        },
        "files": [
          {
            "path": ".jitso/launches/{{LAUNCH_ID}}",
            "exists": false
          }
        ]
      }
    }
  ]
}
