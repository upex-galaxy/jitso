{
  "id": "launch/trust/refusal-survives-a-failing-close",
  "title": "a terminal close that fails does not change the refusal: still exit 2, no registry line, no launch folder",
  "tags": [
    "posix"
  ],
  "source": [
    "intended: owner decision, defect N-22: the folder Orca reports is checked on every launch"
  ],
  "defect": "N-22",
  "intent": "INTENDED behavior (owner decision, defect N-22). The refusal closes the terminal and ignores a failing close, the way the other abandon paths do: the launch still exits 2 with the refusal text, writes no registry line and leaves no launch folder.",
  "project": {
    "files": {
      ".jitso/briefs/brief.md": {
        "from": "brief.md"
      }
    }
  },
  "orca": {
    "cwd": "{{HOME}}/elsewhere",
    "fail_on": [
      "terminal close"
    ]
  },
  "steps": [
    {
      "run": [
        "launch",
        "--build",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/brief.md",
        "--mode",
        "direct"
      ],
      "capture": {
        "LAUNCH_ID": {
          "from": "orca_log",
          "regex": "\\[jitso:(L\\d{8}T\\d{6}-[0-9a-f]{4})\\]"
        }
      },
      "expect": {
        "exit": 2,
        "stdout": [
          {
            "empty": true
          }
        ],
        "stderr": [
          {
            "contains": "untrusted folder {{HOME}}/elsewhere"
          }
        ],
        "orca_calls": {
          "verbs": [
            "terminal create",
            "terminal close"
          ]
        },
        "registry": {
          "count": 0
        },
        "files": [
          {
            "path": ".jitso/launches/{{LAUNCH_ID}}",
            "exists": false
          }
        ]
      }
    }
  ]
}
