{
  "id": "launch/cloud/settings-overrides",
  "title": "the settings file of a user-layer launch holds only overrides: JITSO's keys, the servers allowlist, every plugin off, the owner's CLAUDE.md and its imports excluded, every user skill off, every user agent denied; nothing of the owner's values is copied",
  "source": [
    "intended: docs/decisions.md, section Release 5"
  ],
  "intent": "The user layer brings the owner's preferences, env and hooks by itself, so copying them would run the hooks twice. language and askUserQuestionTimeout pass: the settings reference names no neutral value for them. Sentinel values stand for what must never reach the file, the output, the card or the registry.",
  "tags": [
    "posix"
  ],
  "project": {
    "files": {
      ".jitso/briefs/brief.md": {
        "from": "brief.md"
      },
      "jitso/builds/cloud-worker.yaml": {
        "from": "cloud-worker.yaml"
      }
    }
  },
  "home": {
    "files": {
      ".claude/settings.json": "{\"enabledPlugins\":{\"plug-one@market\":true,\"plug-two@market\":false},\"env\":{\"OWNER_TOKEN\":\"sentinel-env\"},\"hooks\":{\"Stop\":[{\"hooks\":[{\"type\":\"command\",\"command\":\"sentinel-hook\"}]}]},\"language\":\"sentinel-lang\",\"askUserQuestionTimeout\":\"sentinel-timeout\",\"permissions\":{\"allow\":[\"Bash(sentinel:*)\"]}}",
      ".claude/CLAUDE.md": "# Owner notes\n\nsentinel-claude-md\n@~/notes/extra.md\n@rules/style.md\n@missing.md\nSee `@not-an-import.md` here.\n```\n@in-fence.md\n```\n",
      "notes/extra.md": "imported, absolute through ~\n",
      ".claude/rules/style.md": "imported, relative\n",
      ".claude/in-fence.md": "not an import\n",
      ".claude/not-an-import.md": "not an import\n",
      ".claude/skills/alpha/SKILL.md": "---\nname: alpha\ndescription: Alpha.\n---\n\nBody.\n",
      ".claude/skills/humanizer/SKILL.md": "---\nname: humanizer\ndescription: Make text read human.\n---\n\nBody.\n",
      ".agents/skills/beta/SKILL.md": "---\nname: beta\ndescription: Beta.\n---\n\nBody.\n",
      ".claude/agents/planner.md": "---\nname: plan-boss\ndescription: Plans.\n---\n\nsentinel-agent-body\n",
      ".claude/agents/reviewer.md": "Reviews things.\n"
    }
  },
  "claude": {
    "mcp_list": "Checking MCP server health...\n\nplugin:easel:easel: easel-sentinel-cmd --serve - ✓ Connected\nclaude.ai Supabase: https://mcp.supabase.com/mcp - ✓ Connected\nclaude.ai Slack: https://mcp.slack.invalid/mcp - ! Needs authentication\nclaude.ai Google Drive: https://drivemcp.invalid/mcp - ✓ Connected\ndbhub: fixture-dbhub-sentinel-cmd --token sentinel-arg - ✓ Connected\n"
  },
  "steps": [
    {
      "run": [
        "launch",
        "--build",
        "cloud-worker",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/brief.md",
        "--mode",
        "direct"
      ],
      "capture": {
        "LAUNCH_ID": {
          "from": "stdout",
          "regex": "JITSO (L\\d{8}T\\d{6}-[0-9a-f]{4})"
        }
      },
      "expect": {
        "exit": 0,
        "stderr": [
          {
            "empty": true
          }
        ],
        "stdout": [
          {
            "not_contains": "sentinel"
          }
        ],
        "files": [
          {
            "path": ".jitso/launches/{{LAUNCH_ID}}/settings.json",
            "mode": "0600",
            "not_contains": [
              "sentinel"
            ],
            "json": [
              {
                "path": "",
                "keys_exact": [
                  "skipDangerousModePermissionPrompt",
                  "promptSuggestionEnabled",
                  "allowedMcpServers",
                  "claudeMdExcludes",
                  "enabledPlugins",
                  "permissions",
                  "remoteControlAtStartup",
                  "skillOverrides",
                  "hooks"
                ]
              },
              {
                "path": "skipDangerousModePermissionPrompt",
                "equals": true
              },
              {
                "path": "promptSuggestionEnabled",
                "equals": false
              },
              {
                "path": "allowedMcpServers",
                "equals": [
                  {
                    "serverName": "dbhub"
                  },
                  {
                    "serverUrl": "https://mcp.supabase.com/mcp"
                  }
                ]
              },
              {
                "path": "enabledPlugins",
                "equals": {
                  "plug-one@market": false,
                  "plug-two@market": false
                }
              },
              {
                "path": "claudeMdExcludes",
                "equals": [
                  "{{HOME}}/.claude/CLAUDE.md",
                  "{{HOME}}/notes/extra.md",
                  "{{HOME}}/.claude/rules/style.md"
                ]
              },
              {
                "path": "skillOverrides",
                "equals": {
                  "alpha": "off",
                  "beta": "off",
                  "humanizer": "off"
                }
              },
              {
                "path": "permissions",
                "equals": {
                  "deny": [
                    "Agent(plan-boss)",
                    "Agent(reviewer)"
                  ]
                }
              },
              {
                "path": "remoteControlAtStartup",
                "equals": false
              },
              {
                "path": "hooks.PreToolUse.0.matcher",
                "equals": "Bash"
              }
            ]
          },
          {
            "path": ".jitso/launches/{{LAUNCH_ID}}/run.sh",
            "not_contains": [
              "sentinel"
            ]
          },
          {
            "path": ".jitso/launches/{{LAUNCH_ID}}/brief.md",
            "not_contains": [
              "sentinel"
            ]
          },
          {
            "path": ".jitso/launches/{{LAUNCH_ID}}/card.txt",
            "not_contains": [
              "sentinel"
            ]
          },
          {
            "path": ".jitso/launches.jsonl",
            "not_contains": [
              "sentinel"
            ]
          }
        ]
      }
    },
    {
      "exec": "run_sh",
      "launch": "{{LAUNCH_ID}}",
      "expect": {
        "exit": 0,
        "claude": {
          "ran": true,
          "json_file_after": {
            "--settings": [
              {
                "path": "remoteControlAtStartup",
                "equals": false
              }
            ]
          }
        }
      }
    }
  ]
}
