{
  "id": "launch/registry/hashes-are-sha256-of-brief-and-build",
  "title": "brief_sha256 is the SHA-256 of the brief text as given (without the card; for a pointer brief, the text of its target), build_sha256 is a SHA-256 and core_sha256 is gone",
  "source": [
    "cli/jitso/launch.test.ts: launchForReal sha256(p.briefText)",
    "intended: docs/decisions.md, the v0.1.0 cut: the hard rules are removed, so the launch records no core hash"
  ],
  "project": {
    "files": {
      ".jitso/briefs/brief.md": {
        "from": "brief.md"
      }
    }
  },
  "steps": [
    {
      "run": [
        "launch",
        "--build",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/brief.md",
        "--mode",
        "direct"
      ],
      "capture": {
        "LAUNCH_ID": {
          "from": "stdout",
          "regex": "JITSO (L\\d{8}T\\d{6}-[0-9a-f]{4})",
          "group": 1
        }
      },
      "expect": {
        "exit": 0,
        "registry": {
          "count": 1,
          "events": [
            {
              "at": 0,
              "event": "launch",
              "fields": {
                "brief_sha256": "0a518dc169e3a5a1730e6219fce15b0b6bc16035d743c7138406e8fcc2aa13f8",
                "build_sha256": {
                  "regex": "^[0-9a-f]{64}$"
                },
                "core_sha256": {
                  "absent": true
                }
              }
            }
          ]
        }
      }
    }
  ]
}
