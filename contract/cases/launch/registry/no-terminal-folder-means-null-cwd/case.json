{
  "id": "launch/registry/no-terminal-folder-means-null-cwd",
  "title": "when Orca reports no worktree for the terminal, cwd and transcript_path are null and the launch still succeeds",
  "source": [
    "cli/jitso/orca.test.ts: parseWorktreePath(undefined) is null",
    "cli/jitso/launch.ts: event.cwd = created.worktreePath"
  ],
  "project": {
    "files": {
      ".jitso/briefs/brief.md": {
        "from": "brief.md"
      }
    }
  },
  "orca": {
    "cwd": null
  },
  "steps": [
    {
      "run": [
        "launch",
        "--build",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/brief.md",
        "--mode",
        "direct"
      ],
      "capture": {
        "LAUNCH_ID": {
          "from": "stdout",
          "regex": "JITSO (L\\d{8}T\\d{6}-[0-9a-f]{4})",
          "group": 1
        }
      },
      "expect": {
        "exit": 0,
        "registry": {
          "count": 1,
          "events": [
            {
              "at": 0,
              "event": "launch",
              "fields": {
                "cwd": null,
                "transcript_path": null,
                "trust_dialog": "absent"
              }
            }
          ]
        }
      }
    }
  ]
}
