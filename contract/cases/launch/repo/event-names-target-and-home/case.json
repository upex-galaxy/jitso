{
  "id": "launch/repo/event-names-target-and-home",
  "title": "a launch into another repository opens the terminal at path:<target>, answers its trust dialog, and records the target and the home in the caller's registry",
  "tags": [
    "posix"
  ],
  "source": [
    "intended: docs/decisions.md, Only launches are blocked, and launches into other repositories"
  ],
  "intent": "The target path holds a space. The launch folder and the registry line stay in the caller's repository; the event names the target by basename, repo_path and home; the card's launch line follows the target's package.json, because the worker runs there.",
  "project": {
    "files": {
      ".jitso/briefs/brief.md": "## Goal\n\nFind where the sync entry point of this project is defined and explain in a few sentences how it is wired to the rest of the code.\n\n## Scope\n\nRead only. Look at `src/sync.ts` and `docs/guide.md` and nothing outside the repo. Do not change any file.\n\n## Done when\n\nYou can name the file and the line that defines the entry point, and you have checked it by reading the file.\n\n## Report format\n\nOne short paragraph with the file path, the line number and a one line summary of what it does.\n"
    }
  },
  "home": {
    "files": {
      "target app/package.json": "{\"scripts\": {\"jitso\": \"jitso\"}}\n"
    }
  },
  "orca": {
    "responses": {
      "repo list": {
        "repos": [
          {
            "id": "r0",
            "path": "{{PROJECT}}"
          },
          {
            "id": "r1",
            "path": "{{HOME}}/target app"
          }
        ]
      }
    },
    "cwd": "{{HOME}}/target app",
    "screens": [
      "Is this a project you created or one you trust?\n 1. Yes, I trust this folder\n 2. No, exit",
      "❯ \n medium · /effort\n bypass permissions on"
    ]
  },
  "steps": [
    {
      "git_init": {
        "path": "{{HOME}}/target app"
      }
    },
    {
      "run": [
        "launch",
        "--build",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/brief.md",
        "--mode",
        "direct",
        "--repo",
        "{{HOME}}/target app"
      ],
      "capture": {
        "LAUNCH_ID": {
          "from": "stdout",
          "regex": "JITSO (L\\d{8}T\\d{6}-[0-9a-f]{4})",
          "group": 1
        }
      },
      "expect": {
        "exit": 0,
        "stdout": [
          "\ntarget {{HOME}}/target app | home {{PROJECT}}\n",
          "launch: bun run jitso launch"
        ],
        "stderr": [
          {
            "empty": true
          }
        ],
        "orca_calls": {
          "verbs": [
            "repo list",
            "terminal create",
            "terminal wait",
            "terminal read",
            "terminal send",
            "terminal send",
            "terminal read"
          ],
          "calls": [
            {
              "at": 1,
              "argv": [
                "terminal",
                "create",
                "--worktree",
                "path:{{HOME}}/target app",
                "--title",
                "haiku-explorer [jitso:{{LAUNCH_ID}}]",
                "--command",
                "'{{PROJECT}}/.jitso/launches/{{LAUNCH_ID}}/run.sh'"
              ]
            }
          ]
        },
        "registry": {
          "count": 1,
          "events": [
            {
              "at": 0,
              "event": "launch",
              "fields": {
                "repo": "target app",
                "repo_path": "{{HOME}}/target app",
                "home": "{{PROJECT}}",
                "worktree": "primary",
                "cwd": "{{HOME}}/target app",
                "trust_dialog": "handled"
              }
            }
          ]
        },
        "files": [
          {
            "path": ".jitso/launches/{{LAUNCH_ID}}/card.txt",
            "contains": [
              "target {{HOME}}/target app | home {{PROJECT}}"
            ]
          },
          {
            "path": "{{HOME}}/target app/.jitso",
            "exists": false
          }
        ]
      }
    }
  ]
}
