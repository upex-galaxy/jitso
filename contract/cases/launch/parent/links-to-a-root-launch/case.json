{
  "id": "launch/parent/links-to-a-root-launch",
  "title": "--parent of an existing root launch sets parent to it, root to its id and depth to 1",
  "source": [
    "cli/jitso/launch.test.ts: 'a known parent sets root and depth'"
  ],
  "project": {
    "files": {
      ".jitso/briefs/brief.md": {
        "from": "brief.md"
      }
    }
  },
  "steps": [
    {
      "write": {
        "project": {
          ".jitso/launches.jsonl": {
            "content": "{\"v\": 1, \"event\": \"launch\", \"id\": \"L20261113T142233-a3f9\", \"parent\": null, \"root\": \"L20261113T142233-a3f9\", \"depth\": 0, \"ts\": \"2026-11-13T14:22:33.000Z\", \"mode\": \"direct\", \"preset\": \"haiku-explorer\"}\n"
          }
        }
      }
    },
    {
      "run": [
        "launch",
        "--build",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/brief.md",
        "--mode",
        "direct",
        "--parent",
        "L20261113T142233-a3f9"
      ],
      "capture": {
        "LAUNCH_ID": {
          "from": "stdout",
          "regex": "JITSO (L\\d{8}T\\d{6}-[0-9a-f]{4})",
          "group": 1
        }
      },
      "expect": {
        "exit": 0,
        "registry": {
          "count": 2,
          "events": [
            {
              "at": 1,
              "event": "launch",
              "fields": {
                "parent": "L20261113T142233-a3f9",
                "root": "L20261113T142233-a3f9",
                "depth": 1
              }
            }
          ]
        }
      }
    }
  ]
}
