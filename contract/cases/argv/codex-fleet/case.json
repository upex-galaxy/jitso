{
  "title": "a codex build in fleet mode: no first prompt, and the guard travels even though the project registers it for Claude Code",
  "source": [
    "intended: adapters lane (codex reads no .claude/settings.json, so a codex launch always carries the guard)"
  ],
  "tags": [
    "posix"
  ],
  "project": {
    "files": {
      ".jitso/briefs/brief.md": {
        "from": "brief.md"
      },
      "jitso/jitso.yaml": {
        "from": "jitso.yaml"
      },
      "jitso/builds/codex-fleet.yaml": {
        "from": "codex-fleet.yaml"
      },
      ".claude/settings.json": {
        "from": "settings.json"
      }
    }
  },
  "orca": {
    "responses": {
      "orchestration worker-start": {
        "taskId": "task_1"
      }
    }
  },
  "home": {
    "files": {
      "bin/codex": {
        "symlink": "{{BIN}}/claude"
      }
    }
  },
  "steps": [
    {
      "run": [
        "launch",
        "--build",
        "codex-fleet",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/brief.md",
        "--mode",
        "fleet",
        "--run",
        "run_1a2b"
      ],
      "capture": {
        "LAUNCH_ID": {
          "from": "stdout",
          "regex": "JITSO (L\\d{8}T\\d{6}-[0-9a-f]{4})"
        }
      },
      "expect": {
        "exit": 0,
        "stderr": [
          {
            "empty": true
          }
        ],
        "stdout": [
          {
            "regex": "\\njitso: note: codex keeps the MCP servers of the owner's own Codex config; the build's servers are added to them\n$"
          }
        ],
        "registry": {
          "count": 1,
          "events": [
            {
              "at": 0,
              "event": "launch",
              "fields": {
                "harness": "codex",
                "session_id": "",
                "package.guard": true,
                "flags": [
                  "--dangerously-bypass-approvals-and-sandbox",
                  "--dangerously-bypass-hook-trust",
                  "-c",
                  "hooks.PreToolUse=[{matcher=\"Bash\",hooks=[{type=\"command\",command=\"'{{JITSO}}' hook guard\"}]},{matcher=\"mcp__.*orca.*__.*\",hooks=[{type=\"command\",command=\"'{{JITSO}}' hook guard\"}]}]",
                  "-c",
                  "hooks.SessionEnd=[{hooks=[{type=\"command\",command=\"'{{JITSO}}' hook guard\"}]}]",
                  "-m",
                  "gpt-5.5",
                  "-c",
                  "model_reasoning_effort=\"medium\""
                ]
              }
            }
          ]
        },
        "orca_calls": {
          "verbs": [
            "terminal create",
            "terminal wait",
            "terminal read",
            "orchestration worker-start"
          ]
        }
      }
    },
    {
      "exec": "run_sh",
      "launch": "{{LAUNCH_ID}}",
      "env": {
        "PATH": "{{HOME}}/bin:{{BIN}}:/usr/bin:/bin"
      },
      "expect": {
        "exit": 0,
        "claude": {
          "program": "codex",
          "argv": [
            "--dangerously-bypass-approvals-and-sandbox",
            "--dangerously-bypass-hook-trust",
            "-c",
            "hooks.PreToolUse=[{matcher=\"Bash\",hooks=[{type=\"command\",command=\"'{{JITSO}}' hook guard\"}]},{matcher=\"mcp__.*orca.*__.*\",hooks=[{type=\"command\",command=\"'{{JITSO}}' hook guard\"}]}]",
            "-c",
            "hooks.SessionEnd=[{hooks=[{type=\"command\",command=\"'{{JITSO}}' hook guard\"}]}]",
            "-m",
            "gpt-5.5",
            "-c",
            "model_reasoning_effort=\"medium\""
          ]
        }
      }
    }
  ],
  "id": "argv/codex-fleet"
}
