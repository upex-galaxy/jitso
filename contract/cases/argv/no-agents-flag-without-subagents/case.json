{
  "title": "a build that lists no subagents puts no --agents in the claude argv",
  "source": [
    "cli/jitso/adapters/claude.test.ts: '--agents appears only when the preset has subagents' (the without half)"
  ],
  "tags": [
    "posix"
  ],
  "project": {
    "files": {
      ".jitso/briefs/brief.md": {
        "from": "brief.md"
      }
    }
  },
  "for_each": {
    "var": "build",
    "values": [
      "haiku-explorer",
      "sonnet-conductor"
    ]
  },
  "steps": [
    {
      "run": [
        "launch",
        "--build",
        "{{build}}",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/brief.md",
        "--mode",
        "direct"
      ],
      "capture": {
        "LAUNCH_ID": {
          "from": "stdout",
          "regex": "JITSO (L\\d{8}T\\d{6}-[0-9a-f]{4})"
        }
      },
      "expect": {
        "exit": 0
      }
    },
    {
      "exec": "run_sh",
      "launch": "{{LAUNCH_ID}}",
      "expect": {
        "exit": 0,
        "claude": {
          "ran": true,
          "argv_not_contains": [
            "--agents"
          ],
          "argv_contains": [
            "--model"
          ],
          "argv_count": {
            "--dangerously-skip-permissions": 1
          },
          "arg_after": {
            "--session-id": {
              "regex": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          }
        }
      }
    }
  ],
  "id": "argv/no-agents-flag-without-subagents"
}
