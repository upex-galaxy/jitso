{
  "title": "a codex build in direct mode: run.sh starts codex with bypass, the inline guard hooks, model, effort, AGENTS.md off, the build's server and the first prompt",
  "source": [
    "intended: adapters lane (codex 0.171 measured: -c overrides are TOML, inline hooks need --dangerously-bypass-hook-trust, project_doc_max_bytes=0 keeps AGENTS.md out)"
  ],
  "intent": "Codex picks its own session id, so the launch records an empty session_id and no transcript. Codex merges -c servers into the owner's config, so every codex launch prints the note on stderr.",
  "tags": [
    "posix"
  ],
  "project": {
    "files": {
      ".jitso/briefs/brief.md": {
        "from": "brief.md"
      },
      "jitso/jitso.yaml": {
        "from": "jitso.yaml"
      },
      "jitso/builds/codex-worker.yaml": {
        "from": "codex-worker.yaml"
      }
    }
  },
  "home": {
    "files": {
      "bin/codex": {
        "symlink": "{{BIN}}/claude"
      }
    }
  },
  "steps": [
    {
      "run": [
        "launch",
        "--build",
        "codex-worker",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/brief.md",
        "--mode",
        "direct"
      ],
      "capture": {
        "LAUNCH_ID": {
          "from": "stdout",
          "regex": "JITSO (L\\d{8}T\\d{6}-[0-9a-f]{4})"
        }
      },
      "expect": {
        "exit": 0,
        "stderr": [
          {
            "empty": true
          }
        ],
        "stdout": [
          {
            "regex": "\\njitso: note: codex keeps the MCP servers of the owner's own Codex config; the build's servers are added to them\n$"
          }
        ],
        "registry": {
          "count": 1,
          "events": [
            {
              "at": 0,
              "event": "launch",
              "fields": {
                "harness": "codex",
                "session_id": "",
                "transcript_path": null,
                "agents_md": "exclude",
                "package.guard": true,
                "package.flag": "none",
                "package.skills": [],
                "mcp": [
                  "dbhub"
                ]
              }
            }
          ]
        },
        "orca_calls": {
          "verbs": [
            "terminal create",
            "terminal wait",
            "terminal read"
          ]
        },
        "files": [
          {
            "path": ".jitso/launches/{{LAUNCH_ID}}",
            "entries": [
              {
                "equals": "brief.md\ncard.txt\nmcp.json\nrun.sh"
              }
            ]
          },
          {
            "path": ".jitso/launches/{{LAUNCH_ID}}/run.sh",
            "executable": true,
            "contains": [
              "exec 'codex' "
            ]
          }
        ]
      }
    },
    {
      "exec": "run_sh",
      "launch": "{{LAUNCH_ID}}",
      "env": {
        "PATH": "{{HOME}}/bin:{{BIN}}:/usr/bin:/bin"
      },
      "expect": {
        "exit": 0,
        "claude": {
          "program": "codex",
          "argv": [
            "--dangerously-bypass-approvals-and-sandbox",
            "--dangerously-bypass-hook-trust",
            "-c",
            "hooks.PreToolUse=[{matcher=\"Bash\",hooks=[{type=\"command\",command=\"'{{JITSO}}' hook guard\"}]},{matcher=\"mcp__.*orca.*__.*\",hooks=[{type=\"command\",command=\"'{{JITSO}}' hook guard\"}]}]",
            "-c",
            "hooks.SessionEnd=[{hooks=[{type=\"command\",command=\"'{{JITSO}}' hook guard\"}]}]",
            "-m",
            "gpt-5.5",
            "-c",
            "model_reasoning_effort=\"high\"",
            "-c",
            "project_doc_max_bytes=0",
            "-c",
            "mcp_servers.dbhub={command=\"fixture-dbhub\",args=[\"--transport\",\"stdio\"]}",
            {
              "regex": "^Read {{PROJECT}}/\\.jitso/launches/{{LAUNCH_ID}}/brief\\.md and follow it exactly\\.\\nROUTE-SCOPE: none$"
            }
          ]
        }
      }
    },
    {
      "run": [
        "build",
        "validate",
        "codex-worker"
      ],
      "expect": {
        "exit": 0,
        "stdout": [
          {
            "regex": "^ok codex-worker repo jitso/builds/codex-worker\\.yaml\\nchecked 1 builds: 1 ok, 0 invalid\\n$"
          }
        ]
      }
    }
  ],
  "id": "argv/codex-direct"
}
