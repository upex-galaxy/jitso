{
  "id": "brief/section-heading/accepted-forms",
  "title": "headings of level 1 to 6, with an optional colon, any case and loose spacing all count as the section",
  "source": [
    "cli/jitso/brief.test.ts: hasSection regex '^#{1,6}\\\\s*<name>\\\\s*:?\\\\s*$' (im)"
  ],
  "project": {
    "files": {
      ".jitso/briefs/brief.md": {
        "from": "brief.md"
      }
    }
  },
  "for_each": {
    "var": "heading",
    "values": [
      "# Goal",
      "###### Goal",
      "## Goal:",
      "## goal",
      "##Goal",
      "##   GOAL  :  "
    ]
  },
  "steps": [
    {
      "run": [
        "launch",
        "--build",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/brief.md",
        "--mode",
        "direct",
        "--dry-run"
      ],
      "expect": {
        "exit": 0,
        "stderr": [
          {
            "empty": true
          }
        ],
        "stdout": [
          {
            "regex": "^JITSO L\\d{8}T\\d{6}-[0-9a-f]{4} \\|"
          },
          "dry run: nothing was written"
        ],
        "orca_calls": {
          "empty": true
        },
        "registry": {
          "count": 0
        }
      }
    }
  ]
}
