{
  "id": "brief/length/digits-and-punctuation-are-not-words",
  "title": "numbers and punctuation add no words: 39 words plus six numbers is still 39",
  "source": [
    "cli/jitso/brief.test.ts: words() = text.toLowerCase().match(/\\\\p{L}+/gu)"
  ],
  "project": {
    "files": {
      ".jitso/briefs/brief.md": {
        "from": "brief.md"
      }
    }
  },
  "steps": [
    {
      "run": [
        "launch",
        "--build",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/brief.md",
        "--mode",
        "direct"
      ],
      "expect": {
        "exit": 2,
        "stdout": [
          {
            "empty": true
          }
        ],
        "stderr": [
          "length (39 words, expected 40 to 800)"
        ],
        "orca_calls": {
          "empty": true
        },
        "registry": {
          "count": 0
        },
        "files": [
          {
            "path": ".jitso/launches",
            "exists": false
          }
        ]
      }
    }
  ]
}
