{
  "id": "brief/pointer/target-symlink-staying-inside-is-accepted",
  "title": "a target that is a symlink leading to a .md file inside the project is accepted",
  "source": [
    "intended: docs/decisions.md, Pre-release fixes (pointer brief)"
  ],
  "project": {
    "files": {
      ".jitso/briefs/pointer.md": "Brief: docs/link.md\n",
      "docs/cards/w.md": {
        "from": "card.md"
      },
      "docs/link.md": {
        "symlink": "cards/w.md"
      }
    }
  },
  "steps": [
    {
      "run": [
        "launch",
        "--build",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/pointer.md",
        "--mode",
        "direct",
        "--dry-run"
      ],
      "expect": {
        "exit": 0,
        "stdout": [
          "dry run: nothing was written and Orca was not called"
        ],
        "orca_calls": {
          "empty": true
        },
        "registry": {
          "count": 0
        },
        "files": [
          {
            "path": ".jitso/launches",
            "exists": false
          }
        ]
      }
    }
  ]
}
