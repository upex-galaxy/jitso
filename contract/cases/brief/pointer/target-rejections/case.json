{
  "id": "brief/pointer/target-rejections",
  "title": "a pointer whose target is missing, a directory, outside the project, not a .md file, or under a protected path is rejected with its own reason before any launch folder or Orca call",
  "tags": [
    "posix"
  ],
  "source": [
    "intended: docs/decisions.md, Pre-release fixes (pointer brief)"
  ],
  "for_each": {
    "vars": [
      "pointer",
      "reason"
    ],
    "rows": [
      [
        "Brief:\n",
        "brief target path is empty or contains a NUL byte"
      ],
      [
        "Brief: docs/missing.md\n",
        "brief target does not exist: docs/missing.md"
      ],
      [
        "Brief: docs/adir\n",
        "brief target is not a regular file: docs/adir"
      ],
      [
        "Brief: {{HOME}}/card.md\n",
        "brief target is outside the project: {{HOME}}/card.md"
      ],
      [
        "Brief: docs/out.md\n",
        "brief target is outside the project: docs/out.md"
      ],
      [
        "Brief: notes.txt\n",
        "brief target must be a .md file: notes.txt"
      ],
      [
        "Brief: docs/env-link.md\n",
        "brief target must be a .md file: docs/env-link.md"
      ],
      [
        "Brief: .auth/x.md\n",
        "brief target is a protected path: .auth/x.md"
      ],
      [
        "Brief: .jitso/state/x.md\n",
        "brief target is a protected path: .jitso/state/x.md"
      ],
      [
        "Brief: .env.md\n",
        "brief target is a protected path: .env.md"
      ],
      [
        "Brief: .AUTH/y.md\n",
        "brief target is a protected path: .AUTH/y.md"
      ],
      [
        "Brief: docs/auth-link.md\n",
        "brief target is a protected path: docs/auth-link.md"
      ],
      [
        "Brief: .auth/out-link.md\n",
        "brief target is a protected path: .auth/out-link.md"
      ]
    ],
    "ids": [
      "empty-path",
      "missing",
      "directory",
      "absolute-outside",
      "symlink-leading-outside",
      "not-markdown",
      "link-to-a-secret-file",
      "auth-folder",
      "jitso-folder",
      "env-named-md",
      "uppercase-auth-folder",
      "symlink-into-auth",
      "symlink-living-in-auth"
    ]
  },
  "home": {
    "files": {
      "card.md": {
        "from": "card.md"
      }
    }
  },
  "project": {
    "files": {
      ".jitso/briefs/pointer.md": "{{pointer}}",
      "docs/cards/w.md": {
        "from": "card.md"
      },
      "docs/adir/x.md": "text",
      "notes.txt": {
        "from": "card.md"
      },
      "docs/out.md": {
        "symlink": "{{HOME}}/card.md"
      },
      ".env": "PLACEHOLDER=1\n",
      "docs/env-link.md": {
        "symlink": "../.env"
      },
      ".auth/x.md": "harmless fixture text\n",
      ".jitso/state/x.md": "harmless fixture text\n",
      ".env.md": "harmless fixture text\n",
      ".AUTH/y.md": "harmless fixture text\n",
      "docs/auth-link.md": {
        "symlink": "../.auth/x.md"
      },
      ".auth/out-link.md": {
        "symlink": "../docs/cards/w.md"
      }
    }
  },
  "steps": [
    {
      "run": [
        "launch",
        "--build",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/pointer.md",
        "--mode",
        "direct"
      ],
      "expect": {
        "exit": 2,
        "stdout": [
          {
            "empty": true
          }
        ],
        "stderr": [
          "JITSO REJECTED: {{reason}}"
        ],
        "orca_calls": {
          "empty": true
        },
        "registry": {
          "count": 0
        },
        "files": [
          {
            "path": ".jitso/launches",
            "exists": false
          }
        ]
      }
    }
  ]
}
