{
  "id": "brief/section-missing/all",
  "title": "a brief with no section lists all four missing names in order",
  "tags": [
    "posix"
  ],
  "source": [
    "cli/jitso/launch.test.ts: 'a brief that fails the quality checks is rejected with the failing check named' (text: 'just do it')"
  ],
  "project": {
    "files": {
      ".jitso/briefs/brief.md": {
        "from": "brief.md"
      }
    }
  },
  "steps": [
    {
      "run": [
        "launch",
        "--build",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/brief.md",
        "--mode",
        "direct"
      ],
      "expect": {
        "exit": 2,
        "stdout": [
          {
            "empty": true
          }
        ],
        "stderr": [
          "sections (missing section: Goal, Scope, Done when, Report format)"
        ],
        "orca_calls": {
          "empty": true
        },
        "registry": {
          "count": 0
        },
        "files": [
          {
            "path": ".jitso/launches",
            "exists": false
          }
        ]
      }
    }
  ]
}
