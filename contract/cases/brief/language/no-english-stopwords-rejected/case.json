{
  "id": "brief/language/no-english-stopwords-rejected",
  "title": "a brief with almost no English stopwords fails the language check even without Spanish words",
  "tags": [
    "posix"
  ],
  "source": [
    "cli/jitso/brief.test.ts: checkBrief language heuristic (english / tokens < 0.1)"
  ],
  "project": {
    "files": {
      ".jitso/briefs/brief.md": {
        "from": "brief.md"
      }
    }
  },
  "steps": [
    {
      "run": [
        "launch",
        "--build",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/brief.md",
        "--mode",
        "direct"
      ],
      "expect": {
        "exit": 2,
        "stdout": [
          {
            "empty": true
          }
        ],
        "stderr": [
          "language (the brief must be written in English)"
        ],
        "orca_calls": {
          "empty": true
        },
        "registry": {
          "count": 0
        },
        "files": [
          {
            "path": ".jitso/launches",
            "exists": false
          }
        ]
      }
    }
  ]
}
