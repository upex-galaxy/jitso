{
  "id": "brief/language/spanish-rejected-by-default",
  "title": "a Spanish brief is rejected: the brief must be written in English",
  "source": [
    "cli/jitso/launch.test.ts: 'default still rejects a Spanish brief'",
    "cli/jitso/brief.test.ts: 'fails a brief written in Spanish'"
  ],
  "project": {
    "files": {
      ".jitso/briefs/brief.md": {
        "from": "brief.md"
      }
    }
  },
  "steps": [
    {
      "run": [
        "launch",
        "--preset",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/brief.md",
        "--mode",
        "direct"
      ],
      "expect": {
        "exit": 2,
        "stdout": [
          {
            "empty": true
          }
        ],
        "stderr": [
          "language (the brief must be written in English)"
        ],
        "orca_calls": {
          "empty": true
        },
        "registry": {
          "count": 0
        },
        "files": [
          {
            "path": ".jitso/launches",
            "exists": false
          }
        ]
      }
    }
  ]
}
