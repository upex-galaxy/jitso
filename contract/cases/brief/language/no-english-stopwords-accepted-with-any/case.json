{
  "id": "brief/language/no-english-stopwords-accepted-with-any",
  "title": "--brief-language any accepts a brief that has no English stopwords",
  "source": [
    "cli/jitso/brief.test.ts: checkBrief language heuristic (skipped for es and any)"
  ],
  "project": {
    "files": {
      ".jitso/briefs/brief.md": {
        "from": "brief.md"
      }
    }
  },
  "steps": [
    {
      "run": [
        "launch",
        "--preset",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/brief.md",
        "--mode",
        "direct",
        "--brief-language",
        "any",
        "--dry-run"
      ],
      "expect": {
        "exit": 0,
        "stderr": [
          {
            "empty": true
          }
        ],
        "stdout": [
          {
            "regex": "^JITSO L\\d{8}T\\d{6}-[0-9a-f]{4} \\|"
          },
          "dry run: nothing was written"
        ],
        "orca_calls": {
          "empty": true
        },
        "registry": {
          "count": 0
        }
      }
    }
  ]
}
