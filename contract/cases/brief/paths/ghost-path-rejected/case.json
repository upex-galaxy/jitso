{
  "id": "brief/paths/ghost-path-rejected",
  "title": "a cited path that does not exist is rejected and named",
  "tags": [
    "posix"
  ],
  "source": [
    "cli/jitso/brief.test.ts: 'fails on a cited path that does not exist'"
  ],
  "project": {
    "files": {
      ".jitso/briefs/brief.md": {
        "from": "brief.md"
      }
    }
  },
  "steps": [
    {
      "run": [
        "launch",
        "--build",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/brief.md",
        "--mode",
        "direct"
      ],
      "expect": {
        "exit": 2,
        "stdout": [
          {
            "empty": true
          }
        ],
        "stderr": [
          "paths (cited path does not exist: src/ghost/missing-file.ts)",
          {
            "contains": "A file the worker will create goes on a line that starts with Output: or Creates:"
          }
        ],
        "orca_calls": {
          "empty": true
        },
        "registry": {
          "count": 0
        },
        "files": [
          {
            "path": ".jitso/launches",
            "exists": false
          }
        ]
      }
    }
  ]
}
