{
  "id": "brief/paths/declared-output-allowed",
  "title": "a path declared on an Output, Outputs or Creates line does not have to exist",
  "source": [
    "cli/jitso/brief.test.ts: 'passes a cited path that exists, and one declared as an output'",
    "cli/jitso/brief.test.ts: declaredOutputs"
  ],
  "project": {
    "files": {
      ".jitso/briefs/brief.md": {
        "from": "brief.md"
      }
    }
  },
  "for_each": {
    "var": "kw",
    "values": [
      "Output",
      "Outputs",
      "Creates",
      "- Output",
      "* Creates",
      "  OUTPUTS"
    ]
  },
  "steps": [
    {
      "run": [
        "launch",
        "--build",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/brief.md",
        "--mode",
        "direct",
        "--dry-run"
      ],
      "expect": {
        "exit": 0,
        "stderr": [
          {
            "empty": true
          }
        ],
        "stdout": [
          {
            "regex": "^JITSO L\\d{8}T\\d{6}-[0-9a-f]{4} \\|"
          },
          "dry run: nothing was written"
        ],
        "orca_calls": {
          "empty": true
        },
        "registry": {
          "count": 0
        }
      }
    }
  ]
}
