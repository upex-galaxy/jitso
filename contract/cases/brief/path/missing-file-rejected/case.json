{
  "id": "brief/path/missing-file-rejected",
  "title": "a brief path that does not exist is rejected",
  "tags": [
    "posix"
  ],
  "source": [
    "cli/jitso/brief.test.ts: 'rejects a missing file, a directory, an empty path and a NUL byte'"
  ],
  "project": {
    "files": {
      ".jitso/briefs/brief.md": {
        "from": "brief.md"
      }
    }
  },
  "steps": [
    {
      "run": [
        "launch",
        "--build",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/nope.md",
        "--mode",
        "direct"
      ],
      "expect": {
        "exit": 2,
        "stdout": [
          {
            "empty": true
          }
        ],
        "stderr": [
          "JITSO REJECTED: brief file does not exist"
        ],
        "orca_calls": {
          "empty": true
        },
        "registry": {
          "count": 0
        },
        "files": [
          {
            "path": ".jitso/launches",
            "exists": false
          }
        ]
      }
    }
  ]
}
