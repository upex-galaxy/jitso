{
  "id": "brief/path/outside-allowed-folders/dispatch-dir-itself",
  "title": "a brief placed directly in the dispatcher folder, not in its briefs subfolder, is rejected",
  "source": [
    "cli/jitso/launch.test.ts: allowedBriefDirs = [dispatchDir/briefs, stateDir/briefs]"
  ],
  "project": {
    "files": {
      ".jitso/briefs/brief.md": {
        "from": "brief.md"
      }
    }
  },
  "home": {
    "files": {
      ".jitso/dispatch-cwd/brief.md": {
        "from": "brief.md"
      }
    }
  },
  "steps": [
    {
      "run": [
        "launch",
        "--build",
        "haiku-explorer",
        "--brief",
        "{{HOME}}/.jitso/dispatch-cwd/brief.md",
        "--mode",
        "direct"
      ],
      "expect": {
        "exit": 2,
        "stdout": [
          {
            "empty": true
          }
        ],
        "stderr": [
          "JITSO REJECTED: brief file is outside the allowed folders"
        ],
        "orca_calls": {
          "empty": true
        },
        "registry": {
          "count": 0
        },
        "files": [
          {
            "path": ".jitso/launches",
            "exists": false
          }
        ]
      }
    }
  ]
}
