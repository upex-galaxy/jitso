{
  "id": "reap/bad-argument-forms",
  "title": "anything that is not a pair of --run and a value is a usage error with exit 2",
  "source": [
    "cli/jitso/reap.test.ts: 'a bad --run value exits 2 without calling orca' (`--bogus`)"
  ],
  "project": {
    "files": {
      ".jitso/launches.jsonl": "{\"v\":2,\"event\":\"launch\",\"id\":\"L20261113T142233-a3f9\",\"parent\":null,\"root\":\"L20261113T142233-a3f9\",\"depth\":0,\"ts\":\"2026-11-13T14:22:33.000Z\",\"mode\":\"direct\",\"build\":\"haiku-explorer\",\"orca\":{\"run\":null,\"task\":null,\"terminal\":\"term_fake\",\"title\":\"t [jitso:L20261113T142233-a3f9]\"}}\n"
    }
  },
  "orca": {
    "listed": []
  },
  "for_each": {
    "var": "arg",
    "values": [
      "--bogus",
      "extra",
      "--run=run_1",
      "-r",
      "--run"
    ]
  },
  "steps": [
    {
      "run": [
        "reap",
        "{{arg}}"
