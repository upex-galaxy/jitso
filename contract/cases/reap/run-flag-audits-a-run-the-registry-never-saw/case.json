        "--run",
        "run_9",
        "--run",
        "run_1"
      ],
      "expect": {
        "exit": 0,
        "stdout": [
          {
            "regex": "(?m)^jitso reap: 0 launch\\(es\\) marked ended, 3 unlogged worker\\(s\\), 0 analyzed$"
          }
        ],
        "orca_calls": {
          "verbs": [
            "terminal list",
            "orchestration worker-list",
            "orchestration worker-list",
            "orchestration worker-list"
          ],
          "calls": [
            {
              "at": 1,
              "argv": [
                "orchestration",
                "worker-list",
                "--run",
                "run_9"
              ]
            },
            {
              "at": 2,
              "argv": [
                "orchestration",
                "worker-list",
                "--run",
                "run_8"
              ]
            },
            {
              "at": 3,
              "argv": [
