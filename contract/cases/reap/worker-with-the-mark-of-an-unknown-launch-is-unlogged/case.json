{
  "id": "reap/worker-with-the-mark-of-an-unknown-launch-is-unlogged",
  "title": "the mark of a launch that is not in the registry explains nothing",
  "source": [
    "cli/jitso/reap.test.ts: 'a worker is logged by...' (negative side)",
    "cli/jitso/reap.ts: marks come from the registry only"
  ],
  "project": {
    "files": {
      ".jitso/launches.jsonl": "{\"v\":2,\"event\":\"launch\",\"id\":\"L20261113T142233-a3f9\",\"parent\":null,\"root\":\"L20261113T142233-a3f9\",\"depth\":0,\"ts\":\"2026-11-13T14:22:33.000Z\",\"mode\":\"direct\",\"build\":\"haiku-explorer\",\"orca\":{\"run\":\"run_1\",\"task\":\"t\",\"terminal\":\"term_logged\",\"title\":\"t [jitso:L20261113T142233-a3f9]\"}}\n"
    }
  },
  "orca": {
    "listed": [
      "term_logged",
      "term_other"
    ],
    "responses": {
      "orchestration worker-list": {
        "workers": [
          {
            "agentTerminalHandle": "term_other",
            "title": "x [jitso:L20990101T000000-ffff]"
          }
        ]
      }
    }
  },
  "steps": [
    {
      "run": [
        "reap"
      ],
      "expect": {
        "exit": 0,
        "stdout": [
          {
            "regex": "(?m)^jitso reap: 0 launch\\(es\\) marked ended, 1 unlogged worker\\(s\\)$"
          },
          {
            "regex": "(?m)^unlogged worker: worker term_other in run run_1 has no launch event$"
          }
        ],
        "registry": {
          "count": 1
        }
      }
    }
  ]
