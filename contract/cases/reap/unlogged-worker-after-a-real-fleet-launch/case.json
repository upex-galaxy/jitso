{
  "id": "reap/unlogged-worker-after-a-real-fleet-launch",
  "title": "after a real fleet launch, a worker of the same run that no launch event explains is listed as an unlogged worker, and nothing is written",
  "source": [
    "cli/jitso/reap.test.ts: 'a worker in a known run that no launch event explains is an unlogged_worker rule_break'",
    "intended: docs/decisions.md, the v0.1.0 cut (the unlogged worker is output only)"
  ],
  "project": {
    "files": {
      ".jitso/briefs/explore.md": {
        "from": "brief.md"
      }
    }
  },
  "orca": {
    "listed": [
      "term_fake",
      "term_rogue"
    ],
    "responses": {
      "orchestration worker-list": {
        "workers": [
          {
            "agentTerminalHandle": "term_fake",
            "title": "ok"
          },
          {
            "agentTerminalHandle": "term_rogue",
            "title": "worker-task_9"
          }
        ]
      }
    }
  },
  "steps": [
    {
      "run": [
        "launch",
        "--build",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/explore.md",
        "--mode",
        "fleet",
        "--run",
        "run_1",
        "--task",
        "task_1"
      ],
      "capture": {
        "LAUNCH_ID": {
          "from": "stdout",
          "regex": "JITSO (L\\d{8}T\\d{6}-[0-9a-f]{4})"
        }
      },
      "expect": {
        "exit": 0
      }
    },
    {
      "run": [
        "reap"
      ],
      "expect": {
        "exit": 0,
        "stdout": [
          {
            "regex": "(?m)^jitso reap: 0 launch\\(es\\) marked ended, 1 unlogged worker\\(s\\)$"
          },
          {
            "regex": "(?m)^unlogged worker: worker term_rogue in run run_1 has no launch event$"
          }
        ],
        "orca_calls": {
          "calls": [
            {
              "at": 4,
              "argv": [
                "terminal",
                "list"
              ]
            },
            {
              "at": 5,
              "argv": [
                "orchestration",
                "worker-list",
                "--run",
                "run_1"
              ]
            }
          ]
        },
        "registry": {
          "count": 1
        }
      }
    }
  ]
}
