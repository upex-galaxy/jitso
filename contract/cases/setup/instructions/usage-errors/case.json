{
  "id": "setup/instructions/usage-errors",
  "title": "setup instructions with a bad flag, a missing or wrong scope or a stray word is a usage error (exit 2) and writes nothing",
  "source": [
    "intended: docs/decisions.md D8 (setup instructions, defect N-18): a delimited, reversible JITSO block in the instruction files agents read"
  ],
  "defect": "N-18",
  "intent": "INTENDED behavior (defect N-18, setup instructions). `jitso setup` lists `instructions` among what is missing; `--scope` without a value or with a value other than `user` or `project`, a positional word, an unknown flag, and the flags `--force` and `--absolute` that this command does not take are `JITSO REJECTED` messages, exit 2, nothing on stdout, nothing written.",
  "steps": [
    {
      "run": [
        "setup"
      ],
      "expect": {
        "exit": 2,
        "stdout": [
          {
            "empty": true
          }
        ],
        "stderr": [
          {
            "regex": "^jitso setup: missing what to set up \\(hook, instructions\\)\\n\\nUsage: jitso setup hook "
          },
          {
            "not_contains": "unknown command"
          }
        ]
      }
    },
    {
      "run": [
        "setup",
        "instructions",
        "--scope"
      ],
      "expect": {
        "exit": 2,
        "stdout": [
          {
            "empty": true
          }
        ],
        "stderr": [
          {
            "equals": "JITSO REJECTED: --scope needs a value\n"
          }
        ]
      }
    },
    {
      "run": [
        "setup",
        "instructions",
        "--scope",
        "other"
      ],
      "expect": {
        "exit": 2,
        "stdout": [
          {
            "empty": true
          }
        ],
        "stderr": [
          {
            "equals": "JITSO REJECTED: --scope must be user or project\n"
          }
        ]
      }
    },
    {
      "run": [
        "setup",
        "instructions",
        "extra"
      ],
      "expect": {
        "exit": 2,
        "stdout": [
          {
            "empty": true
          }
        ],
        "stderr": [
          {
            "equals": "JITSO REJECTED: unknown argument \"extra\"\n"
          }
        ]
      }
    },
    {
      "run": [
        "setup",
        "instructions",
        "--bogus"
      ],
      "expect": {
        "exit": 2,
        "stdout": [
          {
            "empty": true
          }
        ],
        "stderr": [
          {
            "equals": "JITSO REJECTED: unknown argument \"--bogus\"\n"
          }
        ]
      }
    },
    {
      "run": [
        "setup",
        "instructions",
        "--force"
      ],
      "expect": {
        "exit": 2,
        "stdout": [
          {
            "empty": true
          }
        ],
        "stderr": [
          {
            "equals": "JITSO REJECTED: unknown argument \"--force\"\n"
          }
        ]
      }
    },
    {
      "run": [
        "setup",
        "instructions",
        "--absolute"
      ],
      "expect": {
        "exit": 2,
        "stdout": [
          {
            "empty": true
          }
        ],
        "stderr": [
          {
            "equals": "JITSO REJECTED: unknown argument \"--absolute\"\n"
          }
        ],
        "files": [
          {
            "path": "AGENTS.md",
            "exists": false
          },
          {
            "path": ".jitso",
            "exists": false
          }
        ]
      }
    }
  ]
}
