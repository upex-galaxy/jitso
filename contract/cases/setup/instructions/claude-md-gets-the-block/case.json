{
  "id": "setup/instructions/claude-md-gets-the-block",
  "title": "a CLAUDE.md that does not import AGENTS.md gets the same block, and --remove restores both files",
  "source": [
    "intended: docs/decisions.md D8 (setup instructions, defect N-18): a delimited, reversible JITSO block in the instruction files agents read"
  ],
  "status": {
    "ts": "xfail",
    "go": "pass"
  },
  "defect": "N-18",
  "intent": "INTENDED behavior (defect N-18, setup instructions). Claude Code reads `CLAUDE.md` and not `AGENTS.md` when both exist, so with a `CLAUDE.md` that has no `@AGENTS.md` import, the block goes into both files (AGENTS.md first, created; CLAUDE.md appended with `added=1`). `--remove --yes` deletes the created `AGENTS.md` and gives `CLAUDE.md` its original bytes. The oracle has no `setup` command: it answers `unknown command \"setup\"` on stderr with exit 2 and prints nothing on stdout, so every expectation that needs this output or file effect FAILS on it.",
  "project": {
    "files": {
      "CLAUDE.md": "# Claude\n",
      ".golden/golden-new.md": {
        "from": "golden-new.md"
      },
      ".golden/golden-appended.md": {
        "from": "golden-appended.md"
      }
    }
  },
  "steps": [
    {
      "run": [
        "setup",
        "instructions",
        "--yes"
      ],
      "capture": {
        "NEW": {
          "from": "file",
          "path": ".golden/golden-new.md",
          "regex": "(?s)^(.*)$"
        },
        "APPENDED": {
          "from": "file",
          "path": ".golden/golden-appended.md",
          "regex": "(?s)^(.*)$"
        }
      },
      "expect": {
        "exit": 0,
        "stdout": [
          "+++ b/AGENTS.md",
          "+++ b/CLAUDE.md",
          "created AGENTS.md",
          "wrote CLAUDE.md",
          {
            "regex": "jitso setup instructions: done\\n$"
          }
        ],
        "stderr": [
          {
            "not_contains": "unknown command"
          }
        ],
        "files": [
          {
            "path": "AGENTS.md",
            "equals": "{{NEW}}"
          },
          {
            "path": "CLAUDE.md",
            "equals": "{{APPENDED}}"
          }
        ]
      }
    },
    {
      "run": [
        "setup",
        "instructions",
        "--remove",
        "--yes"
      ],
      "expect": {
        "exit": 0,
        "stdout": [
          "removed AGENTS.md",
          "wrote CLAUDE.md",
          {
            "regex": "jitso setup instructions: done\\n$"
          }
        ],
        "stderr": [
          {
            "not_contains": "unknown command"
          }
        ],
        "files": [
          {
            "path": "AGENTS.md",
            "exists": false
          },
          {
            "path": "CLAUDE.md",
            "equals": "# Claude\n"
          }
        ]
      }
    }
  ]
}
