{
  "id": "setup/instructions/crlf-file-gets-a-crlf-block",
  "title": "a file whose first line break is CRLF gets the block written with CRLF line breaks",
  "source": [
    "intended: docs/decisions.md D8 (setup instructions, defect N-18): a delimited, reversible JITSO block in the instruction files agents read"
  ],
  "defect": "N-18",
  "intent": "INTENDED behavior (defect N-18, setup instructions). The file uses CRLF. The block, its markers and the breaks jitso adds are written with `\\r\\n`, so the file has no mixed line breaks.",
  "project": {
    "files": {
      "AGENTS.md": {
        "from": "seed.md"
      },
      ".golden/seed.md": {
        "from": "seed.md"
      },
      ".golden/golden.md": {
        "from": "golden.md"
      }
    }
  },
  "steps": [
    {
      "run": [
        "setup",
        "instructions",
        "--yes"
      ],
      "capture": {
        "WANT": {
          "from": "file",
          "path": ".golden/golden.md",
          "regex": "(?s)^(.*)$"
        }
      },
      "expect": {
        "exit": 0,
        "stdout": [
          "wrote AGENTS.md",
          {
            "regex": "jitso setup instructions: done\\n$"
          }
        ],
        "stderr": [
          {
            "not_contains": "unknown command"
          }
        ],
        "files": [
          {
            "path": "AGENTS.md",
            "equals": "{{WANT}}"
          }
        ]
      }
    }
  ]
}
