{
  "id": "setup/instructions/user-scope",
  "title": "--scope user writes AGENTS.md in each harness user folder that exists (~/.codex, ~/.config/opencode, ~/.pi/agent), never ~/.claude/CLAUDE.md; --remove undoes it",
  "source": [
    "intended: owner decision (v0.2): JITSO writes instruction blocks to AGENTS.md files only, never to CLAUDE.md"
  ],
  "defect": "N-18",
  "intent": "INTENDED behavior (setup instructions writes AGENTS.md only). With a `~/.codex` folder, an existing `~/.config/opencode/AGENTS.md` and a `~/.pi/agent` folder, `setup instructions --scope user --yes` run from the home folder creates `~/.codex/AGENTS.md` and `~/.pi/agent/AGENTS.md` (`added=new`), appends the block to the opencode file after a backup under `~/.jitso/backups/<id>/`, never creates `~/.claude`, and writes nothing in a project. The preview and the lines use `~/...`. `--remove --yes` deletes the two created files, keeps `~/.codex` and `~/.pi/agent` (they hold a config), and gives the opencode file its original bytes.",
  "project": {
    "files": {
      ".golden/golden-new.md": {
        "from": "golden-new.md"
      },
      ".golden/golden-appended.md": {
        "from": "golden-appended.md"
      }
    }
  },
  "home": {
    "files": {
      ".codex/config.toml": "model = \"x\"\n",
      ".config/opencode/AGENTS.md": "# oc\n",
      ".pi/agent/settings.json": "{}\n"
    }
  },
  "steps": [
    {
      "run": [
        "setup",
        "instructions",
        "--scope",
        "user",
        "--yes"
      ],
      "cwd": "{{HOME}}",
      "capture": {
        "NEW": {
          "from": "file",
          "path": ".golden/golden-new.md",
          "regex": "(?s)^(.*)$"
        },
        "APPENDED": {
          "from": "file",
          "path": ".golden/golden-appended.md",
          "regex": "(?s)^(.*)$"
        }
      },
      "expect": {
        "exit": 0,
        "stdout": [
          "+++ b/~/.codex/AGENTS.md",
          "created ~/.codex/AGENTS.md",
          "wrote ~/.config/opencode/AGENTS.md",
          "created ~/.pi/agent/AGENTS.md",
          {
            "regex": "backed up ~/\\.config/opencode/AGENTS\\.md to ~/\\.jitso/backups/\\d{8}T\\d{6}Z-[0-9a-f]{4}/\\.config/opencode/AGENTS\\.md\\n"
          },
          {
            "not_contains": "CLAUDE.md"
          },
          {
            "regex": "jitso setup instructions: done\\n$"
          }
        ],
        "stderr": [
          {
            "empty": true
          }
        ],
        "files": [
          {
            "path": "{{HOME}}/.codex/AGENTS.md",
            "equals": "{{NEW}}"
          },
          {
            "path": "{{HOME}}/.config/opencode/AGENTS.md",
            "equals": "{{APPENDED}}"
          },
          {
            "path": "{{HOME}}/.pi/agent/AGENTS.md",
            "equals": "{{NEW}}"
          },
          {
            "path": "{{HOME}}/.claude",
            "exists": false
          },
          {
            "path": "AGENTS.md",
            "exists": false
          },
          {
            "path": "{{HOME}}/AGENTS.md",
            "exists": false
          }
        ]
      }
    },
    {
      "run": [
        "setup",
        "instructions",
        "--scope",
        "user",
        "--remove",
        "--yes"
      ],
      "cwd": "{{HOME}}",
      "expect": {
        "exit": 0,
        "stdout": [
          "removed ~/.codex/AGENTS.md",
          "wrote ~/.config/opencode/AGENTS.md",
          "removed ~/.pi/agent/AGENTS.md",
          {
            "regex": "jitso setup instructions: done\\n$"
          }
        ],
        "stderr": [
          {
            "empty": true
          }
        ],
        "files": [
          {
            "path": "{{HOME}}/.codex/AGENTS.md",
            "exists": false
          },
          {
            "path": "{{HOME}}/.codex/config.toml",
            "equals": "model = \"x\"\n"
          },
          {
            "path": "{{HOME}}/.config/opencode/AGENTS.md",
            "equals": "# oc\n"
          },
          {
            "path": "{{HOME}}/.pi/agent/AGENTS.md",
            "exists": false
          },
          {
            "path": "{{HOME}}/.pi/agent/settings.json",
            "equals": "{}\n"
          },
          {
            "path": "{{HOME}}/.claude",
            "exists": false
          }
        ]
      }
    }
  ]
}
