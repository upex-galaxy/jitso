{
  "id": "orca/missing/not-on-path",
  "title": "with no orca on PATH, launch, close and reap exit 3 with one line that says to install Orca, call nothing and write nothing; a dry run still works",
  "source": [
    "intended: a missing Orca is named with an install hint before anything runs"
  ],
  "tags": [
    "posix"
  ],
  "intent": "Every command that drives Orca terminals checks that the orca program can start before it writes anything or calls Orca: launch leaves no launch folder and no registry line, close writes no end event, reap ends nothing. stderr is exactly one line naming the install link and `jitso doctor`. `launch --dry-run` calls no Orca, so it needs none. PATH is the minimal system path (no fake orca), hence the posix tag.",
  "project": {
    "files": {
      ".jitso/briefs/brief.md": {
        "from": "brief.md"
      },
      ".jitso/launches.jsonl": "{\"v\":2,\"event\":\"launch\",\"id\":\"L20261113T142233-a3f9\",\"parent\":null,\"root\":\"L20261113T142233-a3f9\",\"depth\":0,\"ts\":\"2026-11-13T14:22:33.000Z\",\"mode\":\"direct\",\"build\":\"haiku-explorer\",\"orca\":{\"run\":null,\"task\":null,\"terminal\":\"term_fake\",\"title\":\"t [jitso:L20261113T142233-a3f9]\"}}\n"
    }
  },
  "steps": [
    {
      "run": [
        "launch",
        "--build",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/brief.md",
        "--mode",
        "direct"
      ],
      "env": {
        "ORCA_CLI_COMMAND": "",
        "PATH": "/usr/bin:/bin"
      },
      "expect": {
        "exit": 3,
        "stdout": [
          {
            "empty": true
          }
        ],
        "stderr": [
          {
            "equals": "jitso: Orca is not installed (orca is not on PATH). jitso opens and tracks each worker in an Orca terminal: install Orca from https://github.com/stablyai/orca, open it once, then run jitso doctor.\n"
          }
        ],
        "orca_calls": {
          "empty": true
        },
        "registry": {
          "count": 1
        },
        "files": [
          {
            "path": ".jitso/launches",
            "exists": false
          }
        ]
      }
    },
    {
      "run": [
        "close",
        "L20261113T142233-a3f9"
      ],
      "env": {
        "ORCA_CLI_COMMAND": "",
        "PATH": "/usr/bin:/bin"
      },
      "expect": {
        "exit": 3,
        "stdout": [
          {
            "empty": true
          }
        ],
        "stderr": [
          {
            "equals": "jitso: Orca is not installed (orca is not on PATH). jitso opens and tracks each worker in an Orca terminal: install Orca from https://github.com/stablyai/orca, open it once, then run jitso doctor.\n"
          }
        ],
        "orca_calls": {
          "empty": true
        },
        "registry": {
          "count": 1
        },
        "files": [
          {
            "path": ".jitso/launches",
            "exists": false
          }
        ]
      }
    },
    {
      "run": [
        "reap"
      ],
      "env": {
        "ORCA_CLI_COMMAND": "",
        "PATH": "/usr/bin:/bin"
      },
      "expect": {
        "exit": 3,
        "stdout": [
          {
            "empty": true
          }
        ],
        "stderr": [
          {
            "equals": "jitso: Orca is not installed (orca is not on PATH). jitso opens and tracks each worker in an Orca terminal: install Orca from https://github.com/stablyai/orca, open it once, then run jitso doctor.\n"
          }
        ],
        "orca_calls": {
          "empty": true
        },
        "registry": {
          "count": 1
        },
        "files": [
          {
            "path": ".jitso/launches",
            "exists": false
          }
        ]
      }
    },
    {
      "run": [
        "launch",
        "--build",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/brief.md",
        "--mode",
        "direct",
        "--dry-run"
      ],
      "env": {
        "ORCA_CLI_COMMAND": "",
        "PATH": "/usr/bin:/bin"
      },
      "expect": {
        "exit": 0,
        "stdout": [
          {
            "contains": "haiku-explorer"
          }
        ],
        "orca_calls": {
          "empty": true
        },
        "registry": {
          "count": 1
        }
      }
    }
  ]
}
