{
  "id": "project/linked-worktree/launch-writes-state-to-the-primary",
  "title": "a real launch run from inside a linked worktree writes the launch folder and the registry to the PRIMARY checkout, never to the worktree",
  "source": [
    "cli/jitso/root.test.ts: 'is the .jitso folder of the primary checkout, also from a worktree'"
  ],
  "project": {
    "files": {
      ".jitso/briefs/b.md": {
        "from": "brief.md"
      }
    }
  },
  "steps": [
    {
      "git_worktree": {
        "name": "linked"
      }
    },
    {
      "run": [
        "launch",
        "--build",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/b.md",
        "--mode",
        "direct"
      ],
      "cwd": "{{WORKTREE_linked}}",
      "capture": {
        "LAUNCH_ID": {
          "from": "stdout",
          "regex": "JITSO (L\\d{8}T\\d{6}-[0-9a-f]{4})"
        }
      },
      "expect": {
        "exit": 0,
        "registry": {
          "count": 1,
          "events": [
            {
              "at": 0,
              "event": "launch",
              "fields": {
                "id": "{{LAUNCH_ID}}",
                "brief_path": "{{PROJECT}}/.jitso/launches/{{LAUNCH_ID}}/brief.md"
              }
            }
          ]
        },
        "files": [
          {
            "path": "{{PROJECT}}/.jitso/launches/{{LAUNCH_ID}}/run.sh",
            "executable": true
          },
          {
            "path": "{{WORKTREE_linked}}/.jitso",
            "exists": false
          }
        ],
        "orca_calls": {
          "calls": [
            {
              "at": 0,
              "argv": [
                "terminal",
                "create",
                "--title",
                "[jitso:{{LAUNCH_ID}}] haiku-explorer",
                "--command",
                "'{{PROJECT}}/.jitso/launches/{{LAUNCH_ID}}/run.sh'"
              ]
            }
          ]
        }
      }
    }
  ]
}
