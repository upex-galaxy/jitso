{
  "id": "fleet/lists-sessions",
  "title": "fleet joins the registry with the terminal list: a live launch, a launch whose terminal is gone, a terminal no launch explains (unlaunched); a closed launch is not shown; nothing is written",
  "source": [
    "intended: docs/decisions.md, release 1 of the communication plan; orca terminal list --json gives handle, worktreeId, worktreePath, branch, title, connected and writable"
  ],
  "intent": "One header line, one row per session in launch order (id, name, role/type, harness, state, handle, parent, repo, title), the unlaunched terminals after them, then the summary line. The repo of a launch row is the repo field of its launch event (a dash when the line has none); the repo of an unlaunched terminal outside a git checkout is the name of its worktree folder. A launch counts as live when its handle is in the terminal list. The call is read only: the registry keeps its line count, no lock folder appears, and the only Orca verb is the terminal list.",
  "project": {
    "files": {
      ".jitso/launches.jsonl": {
        "from": "launches.jsonl"
      }
    }
  },
  "orca": {
    "responses": {
      "terminal list": {
        "terminals": [
          {
            "handle": "term_a",
            "worktreeId": "uuid-1::/work/repo",
            "worktreePath": "/work/repo",
            "branch": "main",
            "title": "sonnet-conductor [jitso:L20261124T100000-a1a1]",
            "connected": true,
            "writable": true
          },
          {
            "handle": "term_b",
            "worktreeId": "uuid-1::/work/repo",
            "worktreePath": "/work/repo",
            "branch": "main",
            "title": "[jitso:L20261124T100100-b2b2] haiku-explorer",
            "connected": true,
            "writable": true
          },
          {
            "handle": "term_d",
            "worktreeId": "uuid-1::/work/repo",
            "worktreePath": "/work/repo",
            "branch": "main",
            "title": "[jitso:L20261124T090000-d4d4] sonnet-tester",
            "connected": true,
            "writable": true
          },
          {
            "handle": "term_x",
            "worktreeId": "uuid-2::/work/other",
            "worktreePath": "/work/other",
            "branch": "feature",
            "title": "zsh",
            "connected": true,
            "writable": true
          }
        ]
      }
    }
  },
  "steps": [
    {
      "run": [
        "fleet"
      ],
      "expect": {
        "exit": 0,
        "stdout": [
          {
            "regex": "(?m)^ID +NAME +ROLE/TYPE +HARNESS +STATE +HANDLE +PARENT +REPO +TITLE$"
          },
          {
            "regex": "(?m)^L20261124T100000-a1a1 +sonnet-conductor +conductor/conductor +claude +live +term_a +- +repo +sonnet-conductor \\[jitso:L20261124T100000-a1a1\\]$"
          },
          {
            "regex": "(?m)^L20261124T100100-b2b2 +scout +operator/explorer +claude +live +term_b +L20261124T100000-a1a1 +repo +\\[jitso:L20261124T100100-b2b2\\] haiku-explorer$"
          },
          {
            "regex": "(?m)^L20261124T100200-c3c3 +- +operator/worker +pi +gone +term_c +L20261124T100000-a1a1 +- +\\[jitso:L20261124T100200-c3c3\\] pi-worker$"
          },
          {
            "regex": "(?m)^- +- +- +- +unlaunched +term_x +- +other +zsh$"
          },
          {
            "regex": "(?m)^jitso fleet: 2 live, 1 gone, 1 unlaunched$"
          },
          {
            "not_contains": "d4d4"
          }
        ],
        "stderr": [
          {
            "empty": true
          }
        ],
        "orca_calls": {
          "verbs": [
            "terminal list"
          ]
        },
        "registry": {
          "count": 5
        },
        "files": [
          {
            "path": ".jitso/launches.lock",
            "exists": false
          }
        ]
      }
    }
  ]
}
