{
  "id": "fleet/arguments",
  "title": "an unknown flag, a positional word or a repeated flag is a usage rejection (exit 2) before the registry or Orca is touched; --help prints the usage",
  "source": [
    "intended: docs/decisions.md, release 1 of the communication plan; the same shape as the argument check of reap"
  ],
  "project": {
    "files": {
      ".jitso/launches.jsonl": {
        "from": "launches.jsonl"
      }
    }
  },
  "steps": [
    {
      "run": [
        "fleet",
        "--bogus"
      ],
      "expect": {
        "exit": 2,
        "stdout": [
          {
            "empty": true
          }
        ],
        "stderr": [
          {
            "equals": "JITSO REJECTED: usage: jitso fleet [--json] [--all]\n"
          }
        ],
        "orca_calls": {
          "empty": true
        },
        "registry": {
          "count": 5
        }
      }
    },
    {
      "run": [
        "fleet",
        "extra"
      ],
      "expect": {
        "exit": 2,
        "stderr": [
          {
            "equals": "JITSO REJECTED: usage: jitso fleet [--json] [--all]\n"
          }
        ],
        "orca_calls": {
          "empty": true
        }
      }
    },
    {
      "run": [
        "fleet",
        "--json",
        "--json"
      ],
      "expect": {
        "exit": 2,
        "stderr": [
          {
            "equals": "JITSO REJECTED: usage: jitso fleet [--json] [--all]\n"
          }
        ],
        "orca_calls": {
          "empty": true
        }
      }
    },
    {
      "run": [
        "fleet",
        "--help"
      ],
      "expect": {
        "exit": 0,
        "stdout": [
          {
            "contains": "usage: jitso fleet [--json] [--all]"
          }
        ],
        "stderr": [
          {
            "empty": true
          }
        ],
        "orca_calls": {
          "empty": true
        }
      }
    }
  ]
}
