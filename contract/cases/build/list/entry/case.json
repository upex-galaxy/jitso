{
  "id": "build/list/entry",
  "title": "build list prints one line per approved build: id, model, effort, description",
  "source": [
    "cli/jitso/index.test.ts: 'prints every approved preset with what it requires and exits 0'",
    "the oracle's catalog summary: summarizeCatalog"
  ],
  "for_each": {
    "var": "id",
    "values": [
      "haiku-explorer",
      "sonnet-automator",
      "sonnet-conductor",
      "sonnet-tester"
    ]
  },
  "steps": [
    {
      "run": [
        "build",
        "list"
      ],
      "expect": {
        "exit": 0,
        "stderr": [
          {
            "empty": true
          }
        ],
        "orca_calls": {
          "empty": true
        },
        "stdout": [
          {
            "regex": "(?m)^- {{id}}: claude-[a-z0-9-]+ (low|medium|high)\\. .+ requires: .+$"
          }
        ]
      }
    }
  ]
}
