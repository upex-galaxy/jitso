{
  "id": "build/usage",
  "title": "build with no subcommand, or an unknown one, exits 2 with the build usage on stderr; build --help prints it and exits 0",
  "source": [
    "intended: docs/decisions.md D6 and the command-group row (jitso build <subcommand>); `presets` is no longer a command"
  ],
  "defect": "N-10",
  "intent": "INTENDED behavior (defect N-10, build vocabulary; docs/decisions.md D6). The catalog commands live under one command group, `jitso build <subcommand>`. With no subcommand it exits 2 and prints `jitso build: missing subcommand`, a blank line and the build usage on stderr; with a subcommand it does not know it prints `jitso build: unknown subcommand \"<x>\"` and the same usage; `--help` and `-h` print the usage on stdout and exit 0. The build usage also lists `validate [<id>]` (defect N-13). It also lists `list [--drafts]`, `draft <file.yaml|->`, `save <id> [--confirm <token>]` and `discard <id>|--all` (defect N-15, drafts) and `new <id> [--tier <tier>]` (defect N-14, templates).",
  "steps": [
    {
      "run": [
        "build"
      ],
      "expect": {
        "exit": 2,
        "stdout": [
          {
            "empty": true
          }
        ],
        "stderr": [
          "jitso build: missing subcommand",
          "Usage: jitso build",
          "list",
          "validate [<id>]",
          "list [--drafts]",
          "new <id> [--tier <tier>]",
          "draft <file.yaml|->",
          "save <id> [--confirm <token>]",
          "discard <id>|--all"
        ],
        "orca_calls": {
          "empty": true
        }
      }
    },
    {
      "run": [
        "build",
        "show"
      ],
      "expect": {
        "exit": 2,
        "stdout": [
          {
            "empty": true
          }
        ],
        "stderr": [
          "jitso build: unknown subcommand \"show\"",
          "Usage: jitso build",
          "list",
          "validate [<id>]",
          "list [--drafts]",
          "new <id> [--tier <tier>]",
          "draft <file.yaml|->",
          "save <id> [--confirm <token>]",
          "discard <id>|--all"
        ],
        "orca_calls": {
          "empty": true
        }
      }
    },
    {
      "run": [
        "build",
        "--help"
      ],
      "expect": {
        "exit": 0,
        "stdout": [
          "Usage: jitso build",
          "list",
          "validate [<id>]",
          "list [--drafts]",
          "new <id> [--tier <tier>]",
          "draft <file.yaml|->",
          "save <id> [--confirm <token>]",
          "discard <id>|--all"
        ],
        "stderr": [
          {
            "empty": true
          }
        ],
        "orca_calls": {
          "empty": true
        }
      }
    },
    {
      "run": [
        "build",
        "-h"
      ],
      "expect": {
        "exit": 0,
        "stdout": [
          "Usage: jitso build",
          "list",
          "validate [<id>]",
          "list [--drafts]",
          "new <id> [--tier <tier>]",
          "draft <file.yaml|->",
          "save <id> [--confirm <token>]",
          "discard <id>|--all"
        ],
        "stderr": [
          {
            "empty": true
          }
        ],
        "orca_calls": {
          "empty": true
        }
      }
    }
  ]
}
