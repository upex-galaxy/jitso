{
  "id": "hooks/dispatch-guard/write-denies-symlinked-briefs-folder",
  "title": "Write is denied when the briefs folder itself is a symlink",
  "source": [
    "intended: measured on the TypeScript hook (isSymlink on the briefs folder)"
  ],
  "home": {
    "files": {
      "outside/target.md": "x",
      ".jitso/dispatch-cwd/briefs": {
        "symlink": "{{HOME}}/outside"
      }
    }
  },
  "steps": [
    {
      "hook": "dispatch-guard",
      "input": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": {
          "file_path": "{{HOME}}/.jitso/dispatch-cwd/briefs/x.md",
          "content": "x"
        },
        "cwd": "{{HOME}}/.jitso/dispatch-cwd"
      },
      "expect": {
        "exit": 0,
        "decision": "deny",
        "reason": [
          {
            "regex": "(?i)jitso"
          }
        ]
      }
    }
  ]
}
