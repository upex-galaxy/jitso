{
  "id": "hooks/dispatch-guard/bash-denies-a-repeated-flag",
  "title": "a single-value flag that appears twice is denied, even when both values would be allowed",
  "source": [
    "intended: docs/decisions.md A2 (defect N-29): the launch line has one reading"
  ],
  "status": {
    "ts": "xfail",
    "go": "pass"
  },
  "defect": "N-29",
  "intent": "INTENDED behavior (defect N-29). --build, --brief, --mode and --worktree appear exactly once in the dispatcher's launch line, so a repeat is denied with `<flag> is given more than once`, which keeps the line to one reading. The TS binary denies these lines for another reason (it does not allow --build), so the reason text FAILS on TS.",
  "home": {
    "files": {
      ".jitso/dispatch-cwd/briefs/.keep": "",
      "outside/target.md": "x"
    }
  },
  "for_each": {
    "vars": [
      "cmd",
      "flag"
    ],
    "rows": [
      [
        "{{JITSO}} launch --build haiku-explorer --brief /h/b/a.md --mode direct --mode direct --worktree path:{{PROJECT}}",
        "--mode"
      ],
      [
        "{{JITSO}} launch --build a --build b --brief /h/b/a.md --mode direct --worktree path:{{PROJECT}}",
        "--build"
      ],
      [
        "{{JITSO}} launch --build haiku-explorer --brief /h/b/a.md --brief /h/b/b.md --mode direct --worktree path:{{PROJECT}}",
        "--brief"
      ],
      [
        "{{JITSO}} launch --build haiku-explorer --brief /h/b/a.md --mode direct --worktree path:{{PROJECT}} --worktree path:{{PROJECT}}",
        "--worktree"
      ]
    ],
    "ids": [
      "mode",
      "build",
      "brief",
      "worktree"
    ]
  },
  "steps": [
    {
      "hook": "dispatch-guard",
      "input": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Bash",
        "tool_input": {
          "command": "{{cmd}}"
        },
        "cwd": "{{HOME}}/.jitso/dispatch-cwd"
      },
      "env": {
        "JITSO_PROJECT": "{{PROJECT}}"
      },
      "expect": {
        "exit": 0,
        "decision": "deny",
        "reason": [
          {
            "equals": "JITSO dispatch guard: {{flag}} is given more than once"
          }
        ]
      }
    }
  ]
}
