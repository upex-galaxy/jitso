{
  "id": "hooks/dispatch-guard/bash-denies-other-commands",
  "title": "any command that is not the launcher of this repo is denied: other programs, the run-script form, relative and foreign launcher paths",
  "source": [
    ".agents/hooks/jitso-dispatch-guard.test.ts: 'denies ls', 'the run-script form', 'a relative launcher path', 'another launcher path'"
  ],
  "home": {
    "files": {
      ".jitso/dispatch-cwd/briefs/.keep": "",
      "outside/target.md": "x"
    }
  },
  "for_each": {
    "var": "command",
    "values": [
      "ls",
      "bun run jitso launch --preset haiku-explorer --brief /h/b/a.md --mode direct",
      "bun cli/jitso/index.ts launch --preset haiku-explorer --brief /h/b/a.md --mode direct",
      "bun /tmp/evil/cli/jitso/index.ts launch --preset haiku-explorer --brief /h/b/a.md --mode direct",
      "cat /etc/passwd"
    ]
  },
  "steps": [
    {
      "hook": "dispatch-guard",
      "input": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Bash",
        "tool_input": {
          "command": "{{command}}"
        },
        "cwd": "{{HOME}}/.jitso/dispatch-cwd"
      },
      "expect": {
        "exit": 0,
        "decision": "deny",
        "reason": [
          {
            "regex": "(?i)jitso"
          }
        ]
      }
    }
  ]
}
