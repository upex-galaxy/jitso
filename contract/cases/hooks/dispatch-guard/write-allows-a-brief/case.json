{
  "id": "hooks/dispatch-guard/write-allows-a-brief",
  "title": "Write of a new markdown file directly inside the briefs folder is allowed",
  "source": [
    ".agents/hooks/jitso-dispatch-guard.test.ts: 'lets a new brief under briefs/ through'"
  ],
  "home": {
    "files": {
      ".jitso/dispatch-cwd/briefs/.keep": "",
      "outside/target.md": "x",
      ".jitso/dispatch-cwd/briefs/escape": {
        "symlink": "{{HOME}}/outside"
      },
      ".jitso/dispatch-cwd/briefs/link.md": {
        "symlink": "{{HOME}}/outside/target.md"
      }
    }
  },
  "for_each": {
    "var": "name",
    "values": [
      "explore-jira.md",
      "story_PRJ-120.v2.md",
      "Notes.md"
    ]
  },
  "steps": [
    {
      "hook": "dispatch-guard",
      "input": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": {
          "file_path": "{{HOME}}/.jitso/dispatch-cwd/briefs/{{name}}",
          "content": "x"
        },
        "cwd": "{{HOME}}/.jitso/dispatch-cwd"
      },
      "expect": {
        "exit": 0,
        "decision": "allow"
      }
    }
  ]
}
