{
  "id": "hooks/dispatch-guard/write-denies-relative-path",
  "title": "Write is denied for a path that is not absolute",
  "source": [
    ".agents/hooks/jitso-dispatch-guard.test.ts: 'denies a relative path'"
  ],
  "home": {
    "files": {
      ".jitso/dispatch-cwd/briefs/.keep": "",
      "outside/target.md": "x"
    }
  },
  "for_each": {
    "var": "path",
    "values": [
      "briefs/x.md",
      "./x.md",
      "x.md",
      "~/.jitso/dispatch-cwd/briefs/x.md"
    ]
  },
  "steps": [
    {
      "hook": "dispatch-guard",
      "input": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": {
          "file_path": "{{path}}",
          "content": "x"
        },
        "cwd": "{{HOME}}/.jitso/dispatch-cwd"
      },
      "expect": {
        "exit": 0,
        "decision": "deny",
        "reason": [
          {
            "regex": "(?i)jitso"
          }
        ]
      }
    }
  ]
}
