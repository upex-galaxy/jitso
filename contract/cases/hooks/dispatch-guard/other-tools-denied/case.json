{
  "id": "hooks/dispatch-guard/other-tools-denied",
  "title": "any tool other than Bash and Write is denied",
  "source": [
    ".agents/hooks/jitso-dispatch-guard.test.ts: 'denies any tool it was not built for'"
  ],
  "home": {
    "files": {
      ".jitso/dispatch-cwd/briefs/.keep": "",
      "outside/target.md": "x"
    }
  },
  "for_each": {
    "var": "tool",
    "values": [
      "Read",
      "Edit",
      "Task",
      "mcp__orca__start_worker",
      "bash"
    ]
  },
  "steps": [
    {
      "hook": "dispatch-guard",
      "input": {
        "hook_event_name": "PreToolUse",
        "tool_name": "{{tool}}",
        "tool_input": {
          "file_path": "/etc/passwd"
        },
        "cwd": "{{HOME}}/.jitso/dispatch-cwd"
      },
      "expect": {
        "exit": 0,
        "decision": "deny",
        "reason": [
          {
            "regex": "(?i)jitso"
          }
        ]
      }
    }
  ]
}
