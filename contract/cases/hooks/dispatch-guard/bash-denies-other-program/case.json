{
  "id": "hooks/dispatch-guard/bash-denies-other-program",
  "title": "the launcher line run through another program is denied",
  "source": [
    ".agents/hooks/jitso-dispatch-guard.test.ts: 'denies another program'"
  ],
  "home": {
    "files": {
      ".jitso/dispatch-cwd/briefs/.keep": "",
      "outside/target.md": "x"
    }
  },
  "steps": [
    {
      "hook": "dispatch-guard",
      "input": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Bash",
        "tool_input": {
          "command": "python3 {{JITSO}} launch --preset haiku-explorer --brief /h/b/a.md --mode direct"
        },
        "cwd": "{{HOME}}/.jitso/dispatch-cwd"
      },
      "expect": {
        "exit": 0,
        "decision": "deny",
        "reason": [
          {
            "regex": "(?i)jitso"
          }
        ]
      }
    }
  ]
}
