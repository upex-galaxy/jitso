{
  "id": "hooks/dispatch-guard/bash-denies-launcher-tails",
  "title": "the launcher line is denied when it carries shell syntax, a fleet or non-English mode, an unknown flag or a malformed flag list",
  "source": [
    ".agents/hooks/jitso-dispatch-guard.test.ts: 'denies launcher then ls', 'command substitution', 'backticks', 'a pipe', '&&', '||', 'a newline', 'a redirect', 'quotes', 'fleet mode', 'fleet mode, old Spanish spelling', 'upper case', 'the old Spanish direct spelling'",
    "intended: measured on the TypeScript hook for the flag-list rows"
  ],
  "home": {
    "files": {
      ".jitso/dispatch-cwd/briefs/.keep": "",
      "outside/target.md": "x"
    }
  },
  "for_each": {
    "var": "tail",
    "values": [
      "--preset haiku-explorer --brief /h/b/a.md --mode direct; ls",
      "--preset $(whoami) --brief x --mode direct",
      "--preset `whoami` --brief x --mode direct",
      "--preset haiku-explorer --brief /h/b/a.md --mode direct | cat",
      "--preset haiku-explorer --brief /h/b/a.md --mode direct && ls",
      "--preset haiku-explorer --brief /h/b/a.md --mode direct || ls",
      "--preset haiku-explorer --brief /h/b/a.md --mode direct\nls",
      "--preset haiku-explorer --brief /h/b/a.md --mode direct > /tmp/x",
      "--preset 'haiku-explorer' --brief x --mode direct",
      "--preset haiku-explorer --brief x --mode fleet --run r --task t",
      "--preset haiku-explorer --brief x --mode flota --run r --task t",
      "--preset haiku-explorer --brief x --mode FLEET --run r --task t",
      "--preset haiku-explorer --brief x --mode directo",
      "--preset haiku-explorer --brief /h/b/a.md --mode direct --model claude-opus-5-5",
      "--preset haiku-explorer --brief x --mode",
      "--preset --brief x --mode direct",
      "--preset haiku-explorer --brief /h/b/a.md --mode direct  --dry-run",
      "--preset haiku-explorer --brief /h/b/a.md --mode direct stray"
    ]
  },
  "steps": [
    {
      "hook": "dispatch-guard",
      "input": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Bash",
        "tool_input": {
          "command": "{{JITSO}} launch {{tail}}"
        },
        "cwd": "{{HOME}}/.jitso/dispatch-cwd"
      },
      "expect": {
        "exit": 0,
        "decision": "deny",
        "reason": [
          {
            "regex": "(?i)jitso"
          }
        ]
      }
    }
  ]
}
