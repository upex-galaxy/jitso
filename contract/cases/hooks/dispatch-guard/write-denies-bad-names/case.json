{
  "id": "hooks/dispatch-guard/write-denies-bad-names",
  "title": "Write is denied for a non-markdown name, a hidden or spaced name, a nested folder, a \"..\" traversal, a symlinked folder or an existing symlink",
  "source": [
    ".agents/hooks/jitso-dispatch-guard.test.ts: 'denies a non-markdown name', 'a nested folder', 'a .. traversal', 'a symlinked folder', 'an existing symlink'",
    "intended: measured on the TypeScript hook for the hidden and spaced names"
  ],
  "home": {
    "files": {
      ".jitso/dispatch-cwd/briefs/.keep": "",
      "outside/target.md": "x",
      ".jitso/dispatch-cwd/briefs/escape": {
        "symlink": "{{HOME}}/outside"
      },
      ".jitso/dispatch-cwd/briefs/link.md": {
        "symlink": "{{HOME}}/outside/target.md"
      }
    }
  },
  "for_each": {
    "var": "name",
    "values": [
      "run.sh",
      "deep/x.md",
      "../x.md",
      "escape/x.md",
      "link.md",
      ".hidden.md",
      "my brief.md"
    ]
  },
  "steps": [
    {
      "hook": "dispatch-guard",
      "input": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": {
          "file_path": "{{HOME}}/.jitso/dispatch-cwd/briefs/{{name}}",
          "content": "x"
        },
        "cwd": "{{HOME}}/.jitso/dispatch-cwd"
      },
      "expect": {
        "exit": 0,
        "decision": "deny",
        "reason": [
          {
            "regex": "(?i)jitso"
          }
        ]
      }
    }
  ]
}
