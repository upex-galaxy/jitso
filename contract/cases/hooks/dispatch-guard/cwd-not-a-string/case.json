{
  "id": "hooks/dispatch-guard/cwd-not-a-string",
  "title": "the launcher line is denied when cwd is not a string",
  "source": [
    "intended: measured on the TypeScript hook"
  ],
  "home": {
    "files": {
      ".jitso/dispatch-cwd/briefs/.keep": "",
      "outside/target.md": "x"
    }
  },
  "steps": [
    {
      "hook": "dispatch-guard",
      "input": {
        "tool_name": "Bash",
        "tool_input": {
          "command": "{{JITSO}} launch --build haiku-explorer --brief /h/b/a.md --mode direct"
        },
        "cwd": 5
      },
      "expect": {
        "exit": 0,
        "decision": "deny",
        "reason": [
          {
            "regex": "(?i)jitso"
          }
        ]
      }
    }
  ]
}
