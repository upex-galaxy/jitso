{
  "id": "hooks/dispatch-guard/bash-denies-build-commands",
  "title": "the dispatcher may run only the launch line: every build subcommand, save included, is denied",
  "source": [
    "intended: docs/decisions.md D7 and B3-19 (the agent boundary of build save is the launch guard)"
  ],
  "home": {
    "files": {
      ".jitso/dispatch-cwd/briefs/.keep": ""
    }
  },
  "for_each": {
    "var": "command",
    "values": [
      "{{JITSO}} build save x",
      "{{JITSO}} build save x --confirm abc",
      "{{JITSO}} build draft x.yaml",
      "{{JITSO}} build new x",
      "{{JITSO}} build discard --all",
      "{{JITSO}} build list"
    ]
  },
  "steps": [
    {
      "hook": "dispatch-guard",
      "input": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Bash",
        "tool_input": {
          "command": "{{command}}"
        },
        "cwd": "{{HOME}}/.jitso/dispatch-cwd"
      },
      "expect": {
        "exit": 0,
        "decision": "deny",
        "reason": [
          {
            "regex": "(?i)jitso"
          }
        ]
      }
    }
  ]
}
