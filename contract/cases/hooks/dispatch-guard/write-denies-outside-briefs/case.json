{
  "id": "hooks/dispatch-guard/write-denies-outside-briefs",
  "title": "Write is denied outside the briefs folder: the home, the dispatcher folder itself, the briefs folder as a file",
  "source": [
    ".agents/hooks/jitso-dispatch-guard.test.ts: 'denies a path outside briefs/', 'the dispatch folder itself'"
  ],
  "home": {
    "files": {
      ".jitso/dispatch-cwd/briefs/.keep": "",
      "outside/target.md": "x"
    }
  },
  "for_each": {
    "var": "rel",
    "values": [
      "x.md",
      ".jitso/dispatch-cwd/x.md",
      ".jitso/dispatch-cwd/briefs"
    ]
  },
  "steps": [
    {
      "hook": "dispatch-guard",
      "input": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Write",
        "tool_input": {
          "file_path": "{{HOME}}/{{rel}}",
          "content": "x"
        },
        "cwd": "{{HOME}}/.jitso/dispatch-cwd"
      },
      "expect": {
        "exit": 0,
        "decision": "deny",
        "reason": [
          {
            "regex": "(?i)jitso"
          }
        ]
      }
    }
  ]
}
