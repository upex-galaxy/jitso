{
  "id": "hooks/dispatch-guard/bash-denies-env-prefix",
  "title": "an environment assignment before the launcher is denied (the line must start with the launcher)",
  "source": [
    "intended: measured on the TypeScript hook (the first word must be the launcher program)"
  ],
  "home": {
    "files": {
      ".jitso/dispatch-cwd/briefs/.keep": "",
      "outside/target.md": "x"
    }
  },
  "steps": [
    {
      "hook": "dispatch-guard",
      "input": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Bash",
        "tool_input": {
          "command": "FOO=bar {{JITSO}} launch --build haiku-explorer --brief /h/b/a.md --mode direct"
        },
        "cwd": "{{HOME}}/.jitso/dispatch-cwd"
      },
      "expect": {
        "exit": 0,
        "decision": "deny",
        "reason": [
          {
            "regex": "(?i)jitso"
          }
        ]
      }
    }
  ]
}
