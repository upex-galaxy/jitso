{
  "id": "hooks/dispatch-guard/cwd-missing",
  "title": "the launcher line is denied when the payload has no cwd",
  "source": [
    ".agents/hooks/jitso-dispatch-guard.test.ts: 'denies a missing cwd'"
  ],
  "home": {
    "files": {
      ".jitso/dispatch-cwd/briefs/.keep": "",
      "outside/target.md": "x"
    }
  },
  "steps": [
    {
      "hook": "dispatch-guard",
      "input": {
        "tool_name": "Bash",
        "tool_input": {
          "command": "{{JITSO}} launch --build haiku-explorer --brief /h/b/a.md --mode direct"
        }
      },
      "expect": {
        "exit": 0,
        "decision": "deny",
        "reason": [
          {
            "regex": "(?i)jitso"
          }
        ]
      }
    }
  ]
}
