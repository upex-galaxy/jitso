{
  "id": "hooks/dispatch-guard/bash-denies-adoption-commands",
  "title": "the dispatcher may run only the launch line: jitso setup and jitso install are denied",
  "source": [
    "intended: docs/decisions.md D8 and B4-12 (the dispatch guard already denies everything but its launch line)"
  ],
  "home": {
    "files": {
      ".jitso/dispatch-cwd/briefs/.keep": ""
    }
  },
  "for_each": {
    "var": "command",
    "values": [
      "{{JITSO}} setup hook --remove --yes",
      "{{JITSO}} install skill --scope user --yes"
    ]
  },
  "steps": [
    {
      "hook": "dispatch-guard",
      "input": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Bash",
        "tool_input": {
          "command": "{{command}}"
        },
        "cwd": "{{HOME}}/.jitso/dispatch-cwd"
      },
      "expect": {
        "exit": 0,
        "decision": "deny",
        "reason": [
          {
            "regex": "(?i)jitso"
          }
        ]
      }
    }
  ]
}
