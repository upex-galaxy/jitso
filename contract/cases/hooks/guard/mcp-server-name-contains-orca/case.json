{
  "id": "hooks/guard/mcp-server-name-contains-orca",
  "title": "any MCP server whose name contains orca is guarded, not only orca-bridge",
  "source": [
    "intended: measured on the TypeScript hook (`^mcp__.*orca.*__`); the test only exercises claude_ai_orca-bridge"
  ],
  "for_each": {
    "var": "server",
    "values": [
      "orca",
      "plugin_orca_orca"
    ]
  },
  "steps": [
    {
      "hook": "guard",
      "input": {
        "hook_event_name": "PreToolUse",
        "tool_name": "mcp__{{server}}__start_worker",
        "tool_input": {},
        "cwd": "{{PROJECT}}"
      },
      "expect": {
        "exit": 0,
        "decision": "deny",
        "reason": [
          {
            "regex": "\\(denied: orca-bridge start_worker\\)"
          },
          {
            "regex": "launch"
          }
        ]
      }
    }
  ]
}
