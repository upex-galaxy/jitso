{
  "id": "hooks/guard/deny-worktree-create-with-agent",
  "title": "orca worktree create with an agent is denied, with the flag spelled apart or joined by =",
  "source": [
    ".agents/hooks/jitso-guard.test.ts: 'denies worktree create with an agent'"
  ],
  "for_each": {
    "var": "form",
    "values": [
      "--agent claude",
      "--agent=claude"
    ]
  },
  "steps": [
    {
      "hook": "guard",
      "input": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Bash",
        "tool_input": {
          "command": "orca worktree create --name x {{form}}"
        },
        "cwd": "{{PROJECT}}"
      },
      "expect": {
        "exit": 0,
        "decision": "deny",
        "reason": [
          {
            "regex": "\\(denied: worktree create --agent\\)"
          },
          {
            "regex": "launch"
          }
        ]
      }
    }
  ]
}
