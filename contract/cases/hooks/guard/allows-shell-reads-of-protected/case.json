{
  "id": "hooks/guard/allows-shell-reads-of-protected",
  "title": "reading the catalog, the hard rules and jitso/jitso.yaml from a shell stays allowed",
  "source": [
    "intended: docs/decisions.md A5 (defect N-25): the boundary is exact, so what is outside it passes"
  ],
  "for_each": {
    "var": "command",
    "values": [
      "cat jitso/builds/haiku-explorer.yaml",
      "cp jitso/builds/haiku-explorer.yaml /tmp/x",
      "grep -r id jitso/builds",
      "ls jitso/hard-rules",
      "git diff jitso/jitso.yaml",
      "git add jitso/builds/haiku-explorer.yaml",
      "echo jitso/builds > /tmp/list",
      "sed -n 1p jitso/jitso.yaml",
      "diff jitso/jitso.yaml /tmp/j"
    ]
  },
  "steps": [
    {
      "hook": "guard",
      "input": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Bash",
        "tool_input": {
          "command": "{{command}}"
        },
        "cwd": "{{PROJECT}}"
      },
      "expect": {
        "exit": 0,
        "decision": "none",
        "stdout": [
          {
            "empty": true
          }
        ]
      }
    }
  ]
}
