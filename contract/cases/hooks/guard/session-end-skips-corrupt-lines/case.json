{
  "id": "hooks/guard/session-end-skips-corrupt-lines",
  "title": "a corrupt line in the registry does not stop SessionEnd from ending the matching launch",
  "source": [
    "intended: measured on the TypeScript hook (unparsable lines are skipped)"
  ],
  "project": {
    "files": {
      ".jitso/launches.jsonl": "{\"v\":1,\"event\":\"launch\",\"id\":\"L20261113T142233-a3f9\",\"parent\":null,\"root\":\"L20261113T142233-a3f9\",\"depth\":0,\"ts\":\"2026-11-13T14:22:33.000Z\",\"mode\":\"direct\",\"preset\":\"haiku-explorer\",\"session_id\":\"sess-1\"}\nthis is not json\n"
    }
  },
  "steps": [
    {
      "hook": "guard",
      "input": {
        "hook_event_name": "SessionEnd",
        "session_id": "sess-1",
        "reason": "other",
        "cwd": "{{PROJECT}}"
      },
      "expect": {
        "exit": 0,
        "files": [
          {
            "path": ".jitso/launches.jsonl",
            "regex": [
              "\"event\":\\s*\"end\"",
              "\"source\":\\s*\"session_end_hook\""
            ]
          }
        ]
      }
    }
  ]
}
