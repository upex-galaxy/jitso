{
  "id": "hooks/guard/allows-read-only-jitso",
  "title": "the guard stays silent for the jitso commands that only read (doctor, version) and for a dry run of setup, install or init",
  "source": [
    "intended: docs/decisions.md, section \"Only launches are blocked, and launches into other repositories\" (the guard denies only what starts an agent)"
  ],
  "for_each": {
    "var": "command",
    "values": [
      "jitso doctor",
      "jitso version",
      "jitso --version",
      "jitso setup hook --dry-run",
      "jitso install skill --scope user --dry-run",
      "jitso init --dry-run"
    ]
  },
  "steps": [
    {
      "hook": "guard",
      "input": {
        "hook_event_name": "PreToolUse",
        "tool_name": "Bash",
        "tool_input": {
          "command": "{{command}}"
        },
        "cwd": "{{PROJECT}}"
      },
      "expect": {
        "exit": 0,
        "decision": "none",
        "stdout": [
          {
            "empty": true
          }
        ]
      }
    }
  ]
}
