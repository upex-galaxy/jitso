        "claude"
      ],
      [
        "cat <<'EOF' | tee log | bash\nclaude -p hi\nEOF",
        "claude"
      ],
      [
        "bash <(cat <<'EOF'\nclaude -p hi\nEOF\n)",
        "claude"
      ],
      [
        "bash -c \"$(cat <<'EOF'\nclaude -p hi\nEOF\n)\"",
