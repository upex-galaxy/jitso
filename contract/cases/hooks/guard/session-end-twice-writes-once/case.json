  "source": [
    ".agents/hooks/jitso-guard.test.ts: 'a launch that already ended gets no second end event'"
  ],
  "project": {
    "files": {
      ".jitso/launches.jsonl": "{\"v\":1,\"event\":\"launch\",\"id\":\"L20261113T142233-a3f9\",\"parent\":null,\"root\":\"L20261113T142233-a3f9\",\"depth\":0,\"ts\":\"2026-11-13T14:22:33.000Z\",\"mode\":\"direct\",\"preset\":\"haiku-explorer\",\"session_id\":\"sess-1\"}\n"
    }
  },
  "steps": [
