{
  "id": "hooks/guard/allows-writes-elsewhere",
  "title": "the write boundary is exact: drafts, the dispatcher prompt, look-alike names and reads pass",
  "source": [
    "intended: docs/decisions.md A5 (defect N-25): the boundary is exact, so what is outside it passes"
  ],
  "for_each": {
    "vars": [
      "tool",
      "path"
    ],
    "rows": [
      [
        "Write",
        "{{PROJECT}}/src/x.ts"
      ],
      [
        "Write",
        "{{PROJECT}}/.jitso/drafts/x.yaml"
      ],
      [
        "Write",
        "{{PROJECT}}/jitso/dispatcher/prompt.md"
      ],
      [
        "Write",
        "{{PROJECT}}/jitso/builds-notes.md"
      ],
      [
        "Write",
        "{{PROJECT}}/docs/jitso.yaml"
      ],
      [
        "Write",
        "{{PROJECT}}/jitso/jitso.yaml.bak"
      ],
      [
        "Read",
        "{{PROJECT}}/jitso/jitso.yaml"
      ]
    ]
  },
  "steps": [
    {
      "hook": "guard",
      "input": {
        "hook_event_name": "PreToolUse",
        "tool_name": "{{tool}}",
        "tool_input": {
          "file_path": "{{path}}",
          "content": "x"
        },
        "cwd": "{{PROJECT}}"
      },
      "expect": {
        "exit": 0,
        "decision": "none",
        "stdout": [
          {
            "empty": true
          }
        ]
      }
    }
  ]
}
