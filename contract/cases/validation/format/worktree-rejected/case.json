{
  "id": "validation/format/worktree-rejected",
  "title": "--worktree must start with a letter or digit, allow word characters . : / -, hold no .. and be at most 512 long",
  "source": [
    "cli/jitso/shell.ts: FIELD_PATTERNS.worktree"
  ],
  "for_each": {
    "var": "v",
    "values": [
      "a..b",
      "/abs/path",
      ".hidden",
      "wt@host",
      ""
    ]
  },
  "steps": [
    {
      "run": [
        "launch",
        "--build",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/b.md",
        "--mode",
        "direct",
        "--worktree",
        "{{v}}"
      ],
      "expect": {
        "exit": 2,
        "stdout": [
          {
            "empty": true
          }
        ],
        "stderr": [
          "JITSO REJECTED:",
          "invalid value for --worktree"
        ],
        "orca_calls": {
          "empty": true
        }
      }
    }
  ]
}
