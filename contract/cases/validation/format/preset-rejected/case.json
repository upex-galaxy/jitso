{
  "id": "validation/format/preset-rejected",
  "title": "--preset must be a lowercase kebab id of at most 64 characters",
  "source": [
    "cli/jitso/shell.ts: FIELD_PATTERNS.preset"
  ],
  "for_each": {
    "var": "v",
    "values": [
      "Haiku-explorer",
      "1explorer",
      "-explorer",
      "a_b",
      "a.b",
      "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    ]
  },
  "steps": [
    {
      "run": [
        "launch",
        "--preset",
        "{{v}}",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/b.md",
        "--mode",
        "direct"
      ],
      "expect": {
        "exit": 2,
        "stdout": [
          {
            "empty": true
          }
        ],
        "stderr": [
          "JITSO REJECTED:",
          "invalid value for --preset"
        ],
        "orca_calls": {
          "empty": true
        }
      }
    }
  ]
}
