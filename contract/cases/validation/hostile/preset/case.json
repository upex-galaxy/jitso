{
  "id": "validation/hostile/preset",
  "title": "--preset rejects every hostile value of the escape corpus: exit 2, JITSO REJECTED, orca never called",
  "source": [
    "cli/jitso/escape.test.ts: '2b.3: every other model-controlled field' (HOSTILE_VALUES, the NUL one skipped: argv cannot carry NUL)",
    "cli/jitso/shell.ts: checkLaunchField"
  ],
  "for_each": {
    "var": "v",
    "values": [
      "x;ls",
      "x && ls",
      "x||ls",
      "x|ls",
      "$(ls)",
      "`ls`",
      "a b",
      "a\nb",
      "a\rb",
      "'",
      "\"",
      "--flag",
      "-x",
      "../x",
      "a/../b",
      "",
      "\\",
      "a*b",
      "a>b",
      "a#b",
      "a=b;"
    ]
  },
  "steps": [
    {
      "run": [
        "launch",
        "--preset",
        "{{v}}",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/b.md",
        "--mode",
        "direct"
      ],
      "expect": {
        "exit": 2,
        "stdout": [
          {
            "empty": true
          }
        ],
        "stderr": [
          "JITSO REJECTED:",
          "invalid value for --preset"
        ],
        "orca_calls": {
          "empty": true
        },
        "files": [
          {
            "path": ".jitso/launches",
            "exists": false
          }
        ],
        "registry": {
          "count": 0
        }
      }
    }
  ]
}
