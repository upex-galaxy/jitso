{
  "id": "validation/fleet/needs-run-and-rejects-task",
  "title": "fleet mode without --run is rejected, and --task is rejected in fleet mode (JITSO creates the Task from the brief), before any orca call",
  "source": [
    "intended: docs/decisions.md, Pre-release fixes (JITSO creates the Orca Task in fleet mode)"
  ],
  "steps": [
    {
      "run": [
        "launch",
        "--build",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/b.md",
        "--mode",
        "fleet"
      ],
      "expect": {
        "exit": 2,
        "stdout": [
          {
            "empty": true
          }
        ],
        "stderr": [
          "JITSO REJECTED: fleet mode requires --run"
        ],
        "orca_calls": {
          "empty": true
        }
      }
    },
    {
      "run": [
        "launch",
        "--build",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/b.md",
        "--mode",
        "fleet",
        "--task",
        "task_1"
      ],
      "expect": {
        "exit": 2,
        "stdout": [
          {
            "empty": true
          }
        ],
        "stderr": [
          "JITSO REJECTED: --task is not accepted in fleet mode: JITSO creates the Task from the brief"
        ],
        "orca_calls": {
          "empty": true
        }
      }
    },
    {
      "run": [
        "launch",
        "--build",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/b.md",
        "--mode",
        "fleet",
        "--run",
        "run_1",
        "--task",
        "task_1"
      ],
      "expect": {
        "exit": 2,
        "stdout": [
          {
            "empty": true
          }
        ],
        "stderr": [
          "JITSO REJECTED: --task is not accepted in fleet mode: JITSO creates the Task from the brief"
        ],
        "orca_calls": {
          "empty": true
        }
      }
    }
  ]
}
