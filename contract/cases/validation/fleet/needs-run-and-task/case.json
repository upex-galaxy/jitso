{
  "id": "validation/fleet/needs-run-and-task",
  "title": "fleet mode without --run, without --task or without both is rejected before any orca call",
  "source": [
    "cli/jitso/launch.test.ts: 'requires --run and --task and calls no orca without them'"
  ],
  "steps": [
    {
      "run": [
        "launch",
        "--preset",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/b.md",
        "--mode",
        "fleet"
      ],
      "expect": {
        "exit": 2,
        "stdout": [
          {
            "empty": true
          }
        ],
        "stderr": [
          "JITSO REJECTED:",
          "fleet mode requires --run and --task"
        ],
        "orca_calls": {
          "empty": true
        }
      }
    },
    {
      "run": [
        "launch",
        "--preset",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/b.md",
        "--mode",
        "fleet",
        "--run",
        "run_1"
      ],
      "expect": {
        "exit": 2,
        "stderr": [
          "JITSO REJECTED:",
          "fleet mode requires --run and --task"
        ],
        "orca_calls": {
          "empty": true
        }
      }
    },
    {
      "run": [
        "launch",
        "--preset",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/b.md",
        "--mode",
        "fleet",
        "--task",
        "task_1"
      ],
      "expect": {
        "exit": 2,
        "stderr": [
          "JITSO REJECTED:",
          "fleet mode requires --run and --task"
        ],
        "orca_calls": {
          "empty": true
        }
      }
    }
  ]
}
