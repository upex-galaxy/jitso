{
  "id": "validation/required/missing-brief",
  "title": "launch without --brief is rejected",
  "source": [
    "cli/jitso/launch.test.ts: 'preset, brief and a valid mode are required; unknown flags are rejected'"
  ],
  "steps": [
    {
      "run": [
        "launch",
        "--build",
        "haiku-explorer",
        "--mode",
        "direct"
      ],
      "expect": {
        "exit": 2,
        "stdout": [
          {
            "empty": true
          }
        ],
        "stderr": [
          "JITSO REJECTED:",
          "--brief is required"
        ],
        "orca_calls": {
          "empty": true
        }
      }
    }
  ]
}
