{
  "id": "validation/field/unknown-for-preset",
  "title": "a field the preset does not require is rejected by name, even a real field of another preset",
  "source": [
    "cli/jitso/profile.test.ts: 'a field no preset declares is rejected'"
  ],
  "for_each": {
    "var": "v",
    "values": [
      "evil",
      "ticket_key",
      "env"
    ]
  },
  "steps": [
    {
      "run": [
        "launch",
        "--preset",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/b.md",
        "--mode",
        "direct",
        "--field",
        "{{v}}=PRJ-1"
      ],
      "expect": {
        "exit": 2,
        "stdout": [
          {
            "empty": true
          }
        ],
        "stderr": [
          "JITSO REJECTED:",
          "unknown field \"{{v}}\" for preset \"haiku-explorer\""
        ],
        "orca_calls": {
          "empty": true
        }
      }
    }
  ]
}
