{
  "id": "cli/tree-not-implemented",
  "title": "tree answers not implemented on stdout and exits 0, with or without a root argument",
  "source": [
    "cli/jitso/index.test.ts: 'a known subcommand answers \"not implemented\" and exits 0'"
  ],
  "steps": [
    {
      "run": [
        "tree"
      ],
      "expect": {
        "exit": 0,
        "stdout": [
          {
            "regex": "(?i)not implemented"
          }
        ],
        "stderr": [
          {
            "empty": true
          }
        ],
        "orca_calls": {
          "empty": true
        }
      }
    },
    {
      "run": [
        "tree",
        "some-root"
      ],
      "expect": {
        "exit": 0,
        "stdout": [
          {
            "regex": "(?i)not implemented"
          }
        ],
        "stderr": [
          {
            "empty": true
          }
        ],
        "orca_calls": {
          "empty": true
        }
      }
    }
  ]
}
