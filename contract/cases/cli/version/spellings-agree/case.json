{
  "id": "cli/version/spellings-agree",
  "title": "version and --version print the same bytes",
  "source": [
    "intended: one answer for both spellings"
  ],
  "defect": "N-21",
  "intent": "INTENDED behavior (defect N-21, version).",
  "steps": [
    {
      "run": [
        "version"
      ],
      "capture": {
        "V": {
          "from": "stdout",
          "regex": "(?s)^(.*)$"
        }
      },
      "expect": {
        "exit": 0
      }
    },
    {
      "run": [
        "--version"
      ],
      "expect": {
        "exit": 0,
        "stdout": [
          {
            "equals": "{{V}}"
          }
        ]
      }
    }
  ]
}
