'''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''''",
      "a path with   spaces and * ~",
      "EOF\n> canary\n<<EOF",
      "$HOME ${IFS} $0 $@ $*",
      "\\\\ \\n \\'"
    ]
  },
  "steps": [
    {
      "run": [
        "launch",
        "--build",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/brief.md",
        "--mode",
        "direct"
      ],
      "capture": {
        "LAUNCH_ID": {
          "from": "stdout",
          "regex": "JITSO (L\\d{8}T\\d{6}-[0-9a-f]{4})"
        }
      },
      "expect": {
        "exit": 0,
        "orca_calls": {
          "verbs": [
            "terminal create",
            "terminal wait",
            "terminal read"
          ]
        },
        "registry": {
          "count": 1,
          "events": [
            {
              "at": 0,
              "event": "launch",
              "fields": {
                "flags": {
                  "regex": "^\\[\"--dangerously-skip-permissions\",\"--setting-sources\",\"project\",\"--settings\",\"[^\"]+/launches/L\\d{8}T\\d{6}-[0-9a-f]{4}/settings\\.json\",\"--strict-mcp-config\",\"--mcp-config\",\"[^\"]+/launches/L\\d{8}T\\d{6}-[0-9a-f]{4}/mcp\\.json\",\"--model\",\"claude-haiku-5-5\",\"--effort\",\"low\",\"--session-id\",\"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\",\"--name\",\"haiku-explorer\",\"--tools=Read,Glob,Grep,Bash\"\\]$"
                }
              }
            }
          ]
        },
        "files": [
          {
            "path": ".jitso/launches/{{LAUNCH_ID}}/run.sh",
            "exists": true,
            "executable": true
          },
          {
            "path": ".jitso/launches/{{LAUNCH_ID}}/brief.md",
            "contains": [
              "## Goal",
              "## Report format"
            ]
          },
          {
            "path": ".jitso/launches/{{LAUNCH_ID}}/brief.md",
            "contains": [
              "{{text}}"
            ]
          },
          {
            "path": ".jitso/launches/{{LAUNCH_ID}}/run.sh",
            "not_contains": [
              "{{text}}"
            ]
          }
        ]
      }
    },
    {
      "exec": "run_sh",
      "launch": "{{LAUNCH_ID}}",
      "expect": {
        "exit": 0,
        "stdout": [
          {
            "empty": true
          }
        ],
        "stderr": [
          {
            "empty": true
          }
        ],
        "claude": {
          "ran": true,
          "argv_not_contains": [
            "{{text}}",
            "canary",
            "touch",
            "evil"
          ],
          "argv_contains": [
            "--dangerously-skip-permissions",
            "--strict-mcp-config",
            "--session-id"
          ],
          "arg_after": {
            "--setting-sources": "project",
            "--mcp-config": "{{PROJECT}}/.jitso/launches/{{LAUNCH_ID}}/mcp.json",
            "--model": "claude-haiku-5-5",
            "--effort": "low"
          },
          "last_arg": [
            {
              "contains": ".jitso/launches/{{LAUNCH_ID}}/brief.md"
            }
          ],
          "argv_count": {
            "--dangerously-skip-permissions": 1
          }
        },
        "files": [
          {
            "path": "canary",
            "exists": false
          }
        ]
      }
    }
  ],
  "id": "escape/content"
}
