{
  "title": "a brief symlink to a valid brief elsewhere in the project (outside .jitso/briefs) is refused",
  "source": [
    "cli/jitso/escape.test.ts: 'a symlink that leaves the brief folder never becomes an argument' (target inside the project but outside the allowed folders)"
  ],
  "project": {
    "files": {
      ".jitso/briefs/brief.md": {
        "symlink": "{{PROJECT}}/docs/real-brief.md"
      },
      "docs/real-brief.md": {
        "from": "brief.md"
      }
    }
  },
  "steps": [
    {
      "run": [
        "launch",
        "--build",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/brief.md",
        "--mode",
        "direct"
      ],
      "expect": {
        "exit": 2,
        "stderr": [
          "JITSO REJECTED:"
        ],
        "stdout": [
          {
            "empty": true
          }
        ],
        "orca_calls": {
          "empty": true
        },
        "registry": {
          "count": 0
        },
        "files": [
          {
            "path": ".jitso/launches",
            "exists": false
          }
        ]
      }
    }
  ],
  "id": "escape/symlink-to-valid-brief-in-project-outside-folder"
}
