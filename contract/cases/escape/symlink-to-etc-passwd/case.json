{
  "title": "a brief symlink to /etc/passwd is refused",
  "source": [
    "cli/jitso/escape.test.ts: 'a symlink that leaves the brief folder never becomes an argument' (same target as the source test)"
  ],
  "project": {
    "files": {
      ".jitso/briefs/brief.md": {
        "symlink": "/etc/passwd"
      }
    }
  },
  "steps": [
    {
      "run": [
        "launch",
        "--build",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/brief.md",
        "--mode",
        "direct"
      ],
      "expect": {
        "exit": 2,
        "stderr": [
          "JITSO REJECTED:"
        ],
        "stdout": [
          {
            "empty": true
          }
        ],
        "orca_calls": {
          "empty": true
        },
        "registry": {
          "count": 0
        },
        "files": [
          {
            "path": ".jitso/launches",
            "exists": false
          }
        ]
      }
    }
  ],
  "id": "escape/symlink-to-etc-passwd"
}
