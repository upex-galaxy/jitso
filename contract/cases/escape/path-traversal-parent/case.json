{
  "title": "a brief path that climbs out of the brief folder with .. is refused",
  "source": [
    "cli/jitso/escape.test.ts: 'path traversal never becomes an argument'"
  ],
  "project": {
    "files": {
      ".jitso/outside.md": {
        "from": "brief.md"
      }
    }
  },
  "steps": [
    {
      "run": [
        "launch",
        "--preset",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/../outside.md",
        "--mode",
        "direct"
      ],
      "expect": {
        "exit": 2,
        "stderr": [
          "JITSO REJECTED:"
        ],
        "stdout": [
          {
            "empty": true
          }
        ],
        "orca_calls": {
          "empty": true
        },
        "registry": {
          "count": 0
        },
        "files": [
          {
            "path": ".jitso/launches",
            "exists": false
          }
        ]
      }
    }
  ],
  "id": "escape/path-traversal-parent"
}
