{
  "title": "a hostile brief FILE NAME never reaches the claude argv or a shell as syntax: the launch works and run.sh runs one literal word per argument",
  "source": [
    "cli/jitso/escape.test.ts: '2b.1 and 2b.2: a hostile brief never reaches a shell' (file name variants; names that cannot be a file name, NUL and the 4 KB quote run, are skipped as in the source)",
    "corpus order: 0 semicolon | 1 and-and | 2 or-or | 3 pipe | 4 command substitution | 5 backticks | 6 unclosed single quote | 7 unclosed double quote | 8 newline | 9 carriage return | 10 leading double dash | 11 mimics a flag | 12 spaces and a glob | 13 heredoc and redirect | 14 dollar variables | 15 backslashes"
  ],
  "tags": [
    "posix"
  ],
  "project": {
    "files": {
      ".jitso/briefs/{{text}}.md": {
        "from": "brief.md"
      }
    }
  },
  "for_each": {
    "var": "text",
    "values": [
      "x; touch canary",
      "x && touch canary",
      "x || touch canary",
      "x | touch canary",
      "$(touch canary)",
      "`touch canary`",
      "'; touch canary; '",
      "\"; touch canary; \"",
      "x\ntouch canary\n",
      "x\rtouch canary\r",
      "-- touch canary",
      "--dangerously-skip-permissions --model evil",
      "a path with   spaces and * ~",
      "EOF\n> canary\n<<EOF",
      "$HOME ${IFS} $0 $@ $*",
      "\\\\ \\n \\'"
    ]
  },
  "steps": [
    {
      "run": [
        "launch",
        "--build",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/{{text}}.md",
        "--mode",
        "direct"
      ],
      "capture": {
        "LAUNCH_ID": {
          "from": "stdout",
          "regex": "JITSO (L\\d{8}T\\d{6}-[0-9a-f]{4})"
        }
      },
      "expect": {
        "exit": 0,
        "orca_calls": {
          "verbs": [
            "terminal create",
            "terminal wait",
            "terminal read"
          ]
        },
        "registry": {
          "count": 1,
          "events": [
            {
              "at": 0,
              "event": "launch",
              "fields": {
                "flags": {
                  "regex": "^\\[\"--dangerously-skip-permissions\",\"--setting-sources\",\"project\",\"--settings\",\"(?:[^\"\\\\]|\\\\.)*\",\"--strict-mcp-config\",\"--mcp-config\",\"[^\"]+/launches/L\\d{8}T\\d{6}-[0-9a-f]{4}/mcp\\.json\",\"--model\",\"claude-haiku-5-5\",\"--effort\",\"low\",\"--session-id\",\"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\",\"--append-system-prompt-file\",\"[^\"]+/launches/L\\d{8}T\\d{6}-[0-9a-f]{4}/core\\.md\",\"--tools=Read,Glob,Grep,Bash\"\\]$"
                }
              }
            }
          ]
        },
        "files": [
          {
            "path": ".jitso/launches/{{LAUNCH_ID}}/run.sh",
            "exists": true,
            "executable": true
          },
          {
            "path": ".jitso/launches/{{LAUNCH_ID}}/brief.md",
            "contains": [
              "## Goal",
              "## Report format"
            ]
          }
        ]
      }
    },
    {
      "exec": "run_sh",
      "launch": "{{LAUNCH_ID}}",
      "expect": {
        "exit": 0,
        "stdout": [
          {
            "empty": true
          }
        ],
        "stderr": [
          {
            "empty": true
          }
        ],
        "claude": {
          "ran": true,
          "argv_not_contains": [
            "{{text}}",
            "{{text}}.md",
            "canary",
            "touch",
            "evil"
          ],
          "argv_contains": [
            "--dangerously-skip-permissions",
            "--strict-mcp-config",
            "--session-id"
          ],
          "arg_after": {
            "--setting-sources": "project",
            "--mcp-config": "{{PROJECT}}/.jitso/launches/{{LAUNCH_ID}}/mcp.json",
            "--model": "claude-haiku-5-5",
            "--effort": "low",
            "--append-system-prompt-file": "{{PROJECT}}/.jitso/launches/{{LAUNCH_ID}}/core.md"
          },
          "last_arg": [
            {
              "contains": ".jitso/launches/{{LAUNCH_ID}}/brief.md"
            }
          ]
        },
        "files": [
          {
            "path": "canary",
            "exists": false
          }
        ]
      }
    }
  ],
  "id": "escape/filename"
}
