{
  "id": "card/mcp-exclude/unknown-or-differently-cased-name-changes-nothing",
  "title": "excluding a name the preset does not list, or with another case, leaves the MCP part untouched",
  "source": [
    "cli/jitso/launch.test.ts: runLaunch mcp = profile.mcp.filter(name => !args.mcpExclude.includes(name))"
  ],
  "project": {
    "files": {
      ".jitso/briefs/brief.md": {
        "from": "brief.md"
      }
    }
  },
  "for_each": {
    "var": "name",
    "values": [
      "unlisted",
      "DBHUB",
      "nonexistent-server"
    ]
  },
  "steps": [
    {
      "run": [
        "launch",
        "--preset",
        "sonnet-tester",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/brief.md",
        "--mode",
        "direct",
        "--field",
        "ticket_key=PRJ-123",
        "--mcp-exclude",
        "{{name}}",
        "--dry-run"
      ],
      "expect": {
        "exit": 0,
        "stdout": [
          {
            "regex": "(?m)^model\\ claude\\-sonnet\\-5\\-5\\ effort\\ medium\\ \\|\\ bypass\\ \\|\\ MCP\\ dbhub,openapi\\ \\|\\ skill\\ sprint\\-testing$"
          }
        ],
        "stderr": [
          {
            "empty": true
          }
        ],
        "orca_calls": {
          "empty": true
        }
      }
    }
  ]
}
