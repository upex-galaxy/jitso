{
  "id": "card/dry-run/adds-nothing-after-a-real-launch",
  "title": "a dry run after a real launch leaves the registry at one line and adds no orca call",
  "source": [
    "cli/jitso/launch.test.ts: '--dry-run prints the card and calls no orca, writes no file and no event'"
  ],
  "project": {
    "files": {
      ".jitso/briefs/brief.md": {
        "from": "brief.md"
      }
    }
  },
  "steps": [
    {
      "run": [
        "launch",
        "--preset",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/brief.md",
        "--mode",
        "direct"
      ],
      "capture": {
        "LAUNCH_ID": {
          "from": "stdout",
          "regex": "JITSO (L\\d{8}T\\d{6}-[0-9a-f]{4})",
          "group": 1
        }
      },
      "expect": {
        "exit": 0,
        "orca_calls": {
          "count": 3
        },
        "registry": {
          "count": 1
        }
      }
    },
    {
      "run": [
        "launch",
        "--preset",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/brief.md",
        "--mode",
        "direct",
        "--dry-run"
      ],
      "expect": {
        "exit": 0,
        "stdout": [
          {
            "regex": "dry run: nothing was written"
          }
        ],
        "orca_calls": {
          "count": 3
        },
        "registry": {
          "count": 1
        }
      }
    }
  ]
}
