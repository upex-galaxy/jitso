{
  "id": "card/dry-run/writes-nothing-direct",
  "title": "a direct dry run writes no launch folder, no registry line and calls no orca verb",
  "source": [
    "cli/jitso/launch.test.ts: '--dry-run prints the card and calls no orca, writes no file and no event'"
  ],
  "project": {
    "files": {
      ".jitso/briefs/brief.md": {
        "from": "brief.md"
      }
    }
  },
  "steps": [
    {
      "run": [
        "launch",
        "--preset",
        "haiku-explorer",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/brief.md",
        "--mode",
        "direct",
        "--dry-run"
      ],
      "capture": {
        "LAUNCH_ID": {
          "from": "stdout",
          "regex": "JITSO (L\\d{8}T\\d{6}-[0-9a-f]{4})",
          "group": 1
        }
      },
      "expect": {
        "exit": 0,
        "stdout": [
          {
            "regex": "dry run: nothing was written and Orca was not called"
          }
        ],
        "orca_calls": {
          "empty": true
        },
        "registry": {
          "count": 0
        },
        "files": [
          {
            "path": ".jitso/launches",
            "exists": false
          },
          {
            "path": ".jitso/launches.jsonl",
            "exists": false
          },
          {
            "path": ".jitso/launches.lock",
            "exists": false
          }
        ]
      }
    }
  ]
}
