{
  "id": "install/skill/user-scope",
  "title": "install skill --scope user writes under the home folder from any folder, and --remove undoes it",
  "source": [
    "intended: docs: B4B5-DESIGN.md `install skill` usage (user scope), Facts on skill discovery paths"
  ],
  "defect": "N-16",
  "intent": "INTENDED behavior (defect N-16, B4.3). `--scope user` needs no project: from the home folder it writes `~/.agents/skills/jitso/` and the link `~/.claude/skills/jitso -> ../../.agents/skills/jitso`, printing paths as `~/...`; `--remove --yes` removes them and prunes `~/.agents` and `~/.claude`.",
  "steps": [
    {
      "run": [
        "install",
        "skill",
        "--scope",
        "user",
        "--yes"
      ],
      "cwd": "{{HOME}}",
      "expect": {
        "exit": 0,
        "stdout": [
          "created ~/.agents/skills/jitso/SKILL.md",
          "created ~/.agents/skills/jitso/.jitso-skill.json",
          "linked ~/.claude/skills/jitso -> ../../.agents/skills/jitso",
          "note: a launched session does not read the user skill; a launch carries the jitso skill for a conductor build or a build that names jitso, and a build gets other user skills only as user:<name> allowlisted in ~/.jitso/jitso.yaml",
          "jitso install skill: done"
        ],
        "stderr": [
          {
            "empty": true
          }
        ],
        "files": [
          {
            "path": "{{HOME}}/.agents/skills/jitso/SKILL.md",
            "regex": [
              "^---\nname: jitso\n"
            ]
          },
          {
            "path": "{{HOME}}/.claude/skills/jitso/SKILL.md"
          },
          {
            "path": "{{HOME}}/.agents/skills/jitso/.jitso-skill.json",
            "json": [
              {
                "path": "skill",
                "equals": "jitso"
              }
            ]
          },
          {
            "path": "{{PROJECT}}/.agents/skills",
            "exists": false
          }
        ]
      }
    },
    {
      "run": [
        "install",
        "skill",
        "--scope",
        "user",
        "--yes"
      ],
      "cwd": "{{HOME}}",
      "expect": {
        "exit": 0,
        "stdout": [
          "nothing to do (the jitso skill "
        ]
      }
    },
    {
      "run": [
        "install",
        "skill",
        "--scope",
        "user",
        "--remove",
        "--yes"
      ],
      "cwd": "{{HOME}}",
      "expect": {
        "exit": 0,
        "stdout": [
          "removed ~/.agents/skills/jitso/SKILL.md",
          "unlinked ~/.claude/skills/jitso",
          "jitso install skill: done"
        ],
        "files": [
          {
            "path": "{{HOME}}/.agents",
            "exists": false
          },
          {
            "path": "{{HOME}}/.claude",
            "exists": false
          }
        ]
      }
    }
  ]
}
