{
  "id": "install/skill/usage-errors",
  "title": "install and install skill answer a missing or wrong word, scope or argument with the exact message and exit 2",
  "source": [
    "intended: docs: B4B5-DESIGN.md `install skill` input table"
  ],
  "defect": "N-16",
  "intent": "INTENDED behavior (defect N-16, B4.3). `install` alone is `jitso install: missing what to install (skill)` and the usage; `install plugin` is `jitso install: unknown subcommand \"plugin\"` and the usage; no `--scope` is `JITSO REJECTED: install skill needs --scope user or --scope project`; a bad value, a missing value, an unknown flag and a stray word are the launch messages. All exit 2, stdout empty, nothing written.",
  "steps": [
    {
      "run": [
        "install"
      ],
      "expect": {
        "exit": 2,
        "stdout": [
          {
            "empty": true
          }
        ],
        "stderr": [
          "jitso install: missing what to install (skill)\n\nUsage: jitso install skill --scope user|project",
          {
            "not_contains": "unknown command"
          }
        ],
        "files": [
          {
            "path": ".agents/skills",
            "exists": false
          },
          {
            "path": ".claude",
            "exists": false
          },
          {
            "path": ".jitso",
            "exists": false
          }
        ]
      }
    },
    {
      "run": [
        "install",
        "plugin"
      ],
      "expect": {
        "exit": 2,
        "stdout": [
          {
            "empty": true
          }
        ],
        "stderr": [
          "jitso install: unknown subcommand \"plugin\"\n\nUsage: jitso install skill --scope user|project",
          {
            "not_contains": "unknown command"
          }
        ],
        "files": [
          {
            "path": ".agents/skills",
            "exists": false
          },
          {
            "path": ".claude",
            "exists": false
          },
          {
            "path": ".jitso",
            "exists": false
          }
        ]
      }
    },
    {
      "run": [
        "install",
        "skill"
      ],
      "expect": {
        "exit": 2,
        "stdout": [
          {
            "empty": true
          }
        ],
        "stderr": [
          {
            "equals": "JITSO REJECTED: install skill needs --scope user or --scope project\n"
          }
        ],
        "files": [
          {
            "path": ".agents/skills",
            "exists": false
          },
          {
            "path": ".claude",
            "exists": false
          },
          {
            "path": ".jitso",
            "exists": false
          }
        ]
      }
    },
    {
      "run": [
        "install",
        "skill",
        "--scope",
        "team"
      ],
      "expect": {
        "exit": 2,
        "stdout": [
          {
            "empty": true
          }
        ],
        "stderr": [
          {
            "equals": "JITSO REJECTED: --scope must be user or project\n"
          }
        ],
        "files": [
          {
            "path": ".agents/skills",
            "exists": false
          },
          {
            "path": ".claude",
            "exists": false
          },
          {
            "path": ".jitso",
            "exists": false
          }
        ]
      }
    },
    {
      "run": [
        "install",
        "skill",
        "--scope"
      ],
      "expect": {
        "exit": 2,
        "stdout": [
          {
            "empty": true
          }
        ],
        "stderr": [
          {
            "equals": "JITSO REJECTED: --scope needs a value\n"
          }
        ],
        "files": [
          {
            "path": ".agents/skills",
            "exists": false
          },
          {
            "path": ".claude",
            "exists": false
          },
          {
            "path": ".jitso",
            "exists": false
          }
        ]
      }
    },
    {
      "run": [
        "install",
        "skill",
        "--scope",
        "project",
        "extra"
      ],
      "expect": {
        "exit": 2,
        "stdout": [
          {
            "empty": true
          }
        ],
        "stderr": [
          {
            "equals": "JITSO REJECTED: unknown argument \"extra\"\n"
          }
        ],
        "files": [
          {
            "path": ".agents/skills",
            "exists": false
          },
          {
            "path": ".claude",
            "exists": false
          },
          {
            "path": ".jitso",
            "exists": false
          }
        ]
      }
    },
    {
      "run": [
        "install",
        "skill",
        "--scope",
        "project",
        "--bogus"
      ],
      "expect": {
        "exit": 2,
        "stdout": [
          {
            "empty": true
          }
        ],
        "stderr": [
          {
            "equals": "JITSO REJECTED: unknown argument \"--bogus\"\n"
          }
        ],
        "files": [
          {
            "path": ".agents/skills",
            "exists": false
          },
          {
            "path": ".claude",
            "exists": false
          },
          {
            "path": ".jitso",
            "exists": false
          }
        ]
      }
    },
    {
      "run": [
        "install",
        "skill",
        "--scope",
        "project",
        "--absolute"
      ],
      "expect": {
        "exit": 2,
        "stdout": [
          {
            "empty": true
          }
        ],
        "stderr": [
          {
            "equals": "JITSO REJECTED: unknown argument \"--absolute\"\n"
          }
        ],
        "files": [
          {
            "path": ".agents/skills",
            "exists": false
          },
          {
            "path": ".claude",
            "exists": false
          },
          {
            "path": ".jitso",
            "exists": false
          }
        ]
      }
    }
  ]
}
