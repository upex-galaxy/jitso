{
  "id": "install/skill/remove-round-trip",
  "title": "install skill --remove undoes an install and prunes the folders it made, keeping the fixture's own .agents/instructions",
  "source": [
    "intended: docs: B4B5-DESIGN.md B4-1, states table (current, --remove)"
  ],
  "defect": "N-16",
  "intent": "INTENDED behavior (defect N-16, B4.3). `--remove --yes` after an install removes the skill files, the manifest and the link (`removed <path>`, `unlinked .claude/skills/jitso`), then prunes `.agents/skills/jitso`, `.agents/skills`, `.claude/skills` and `.claude` when they are empty, and never `.agents` while it holds something else (the fixture has `.agents/instructions`). A second `--remove` says `nothing to do (the jitso skill is not installed at project scope)`, and installing again works.",
  "steps": [
    {
      "run": [
        "install",
        "skill",
        "--scope",
        "project",
        "--yes"
      ],
      "expect": {
        "exit": 0,
        "stdout": [
          "jitso install skill: done"
        ]
      }
    },
    {
      "run": [
        "install",
        "skill",
        "--scope",
        "project",
        "--remove",
        "--yes"
      ],
      "expect": {
        "exit": 0,
        "stdout": [
          "removed .agents/skills/jitso/SKILL.md",
          "removed .agents/skills/jitso/references/README.md",
          "removed .agents/skills/jitso/.jitso-skill.json",
          "unlinked .claude/skills/jitso",
          "jitso install skill: done"
        ],
        "stderr": [
          {
            "empty": true
          }
        ],
        "files": [
          {
            "path": ".agents/skills",
            "exists": false
          },
          {
            "path": ".agents/skills/jitso",
            "exists": false
          },
          {
            "path": ".claude",
            "exists": false
          },
          {
            "path": ".agents/instructions",
            "exists": true
          }
        ]
      }
    },
    {
      "run": [
        "install",
        "skill",
        "--scope",
        "project",
        "--remove",
        "--yes"
      ],
      "expect": {
        "exit": 0,
        "stdout": [
          "jitso install skill: nothing to do (the jitso skill is not installed at project scope)"
        ],
        "stderr": [
          {
            "empty": true
          }
        ]
      }
    },
    {
      "run": [
        "install",
        "skill",
        "--scope",
        "project",
        "--yes"
      ],
      "expect": {
        "exit": 0,
        "stdout": [
          "created .agents/skills/jitso/SKILL.md",
          "jitso install skill: done"
        ],
        "files": [
          {
            "path": ".claude/skills/jitso/SKILL.md"
          }
        ]
      }
    }
  ]
}
