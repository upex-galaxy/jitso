{
  "id": "install/skill/unmanaged-folder-is-refused",
  "title": "a skill folder that jitso did not install is refused without --force",
  "source": [
    "intended: docs: B4B5-DESIGN.md B4-16, states table (unmanaged)"
  ],
  "defect": "N-16",
  "intent": "INTENDED behavior (defect N-16, B4.3). A folder `.agents/skills/jitso` with no `.jitso-skill.json` is not jitso's: exit 2 with `JITSO REJECTED: the jitso skill in .agents/skills/jitso is not a copy jitso installed (no .jitso-skill.json); nothing written; run again with --force to replace it (a backup is kept)`, the folder untouched and no link made. With `--force` the file is backed up and replaced by the shipped skill.",
  "project": {
    "files": {
      ".agents/skills/jitso/SKILL.md": "x\n"
    }
  },
  "steps": [
    {
      "run": [
        "install",
        "skill",
        "--scope",
        "project",
        "--yes"
      ],
      "expect": {
        "exit": 2,
        "stdout": [
          "--- a/.agents/skills/jitso/SKILL.md",
          "-x"
        ],
        "stderr": [
          "JITSO REJECTED: the jitso skill in .agents/skills/jitso is not a copy jitso installed (no .jitso-skill.json)",
          "--force",
          "nothing written",
          {
            "not_contains": "unknown command"
          }
        ],
        "files": [
          {
            "path": ".agents/skills/jitso/SKILL.md",
            "equals": "x\n"
          },
          {
            "path": ".agents/skills/jitso/.jitso-skill.json",
            "exists": false
          },
          {
            "path": ".claude",
            "exists": false
          },
          {
            "path": ".jitso",
            "exists": false
          }
        ]
      }
    },
    {
      "run": [
        "install",
        "skill",
        "--scope",
        "project",
        "--yes",
        "--force"
      ],
      "expect": {
        "exit": 0,
        "stdout": [
          "backed up .agents/skills/jitso/SKILL.md to ",
          "wrote .agents/skills/jitso/SKILL.md",
          "linked .claude/skills/jitso -> ../../.agents/skills/jitso",
          "jitso install skill: done"
        ],
        "files": [
          {
            "path": ".agents/skills/jitso/SKILL.md",
            "regex": [
              "^---\nname: jitso\n"
            ]
          },
          {
            "path": ".agents/skills/jitso/.jitso-skill.json"
          }
        ]
      }
    }
  ]
}
