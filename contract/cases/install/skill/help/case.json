{
  "id": "install/skill/help",
  "title": "install --help, install -h and install skill --help print the usage on stdout and exit 0",
  "source": [
    "intended: docs: B4B5-DESIGN.md `install skill` usage block"
  ],
  "defect": "N-16",
  "intent": "INTENDED behavior (defect N-16, B4.3). The usage names the synopsis, the two scopes with the folders they write, and each flag.",
  "steps": [
    {
      "run": [
        "install",
        "--help"
      ],
      "expect": {
        "exit": 0,
        "stdout": [
          "Usage: jitso install skill --scope user|project [--remove] [--force] [--dry-run] [--yes]",
          "--scope",
          "--remove",
          "--force",
          "--dry-run",
          "--yes",
          ".agents/skills/jitso/",
          ".claude/skills/jitso"
        ],
        "stderr": [
          {
            "empty": true
          }
        ],
        "files": [
          {
            "path": ".agents/skills",
            "exists": false
          },
          {
            "path": ".claude",
            "exists": false
          },
          {
            "path": ".jitso",
            "exists": false
          }
        ]
      }
    },
    {
      "run": [
        "install",
        "-h"
      ],
      "expect": {
        "exit": 0,
        "stdout": [
          "Usage: jitso install skill --scope user|project [--remove] [--force] [--dry-run] [--yes]",
          "--scope",
          "--remove",
          "--force",
          "--dry-run",
          "--yes",
          ".agents/skills/jitso/",
          ".claude/skills/jitso"
        ],
        "stderr": [
          {
            "empty": true
          }
        ],
        "files": [
          {
            "path": ".agents/skills",
            "exists": false
          },
          {
            "path": ".claude",
            "exists": false
          },
          {
            "path": ".jitso",
            "exists": false
          }
        ]
      }
    },
    {
      "run": [
        "install",
        "skill",
        "--help"
      ],
      "expect": {
        "exit": 0,
        "stdout": [
          "Usage: jitso install skill --scope user|project [--remove] [--force] [--dry-run] [--yes]",
          "--scope",
          "--remove",
          "--force",
          "--dry-run",
          "--yes",
          ".agents/skills/jitso/",
          ".claude/skills/jitso"
        ],
        "stderr": [
          {
            "empty": true
          }
        ],
        "files": [
          {
            "path": ".agents/skills",
            "exists": false
          },
          {
            "path": ".claude",
            "exists": false
          },
          {
            "path": ".jitso",
