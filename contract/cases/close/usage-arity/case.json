{
  "id": "close/usage-arity",
  "title": "close needs exactly one argument: none or an extra one is a usage error with exit 2",
  "source": [
    "cli/jitso/close.test.ts: 'a malformed id exits 2' (usage branch of runClose)"
  ],
  "project": {
    "files": {
      ".jitso/launches.jsonl": "{\"v\":2,\"event\":\"launch\",\"id\":\"L20261113T142233-a3f9\",\"parent\":null,\"root\":\"L20261113T142233-a3f9\",\"depth\":0,\"ts\":\"2026-11-13T14:22:33.000Z\",\"mode\":\"direct\",\"build\":\"haiku-explorer\",\"orca\":{\"run\":null,\"task\":null,\"terminal\":\"term_fake\",\"title\":\"t [jitso:L20261113T142233-a3f9]\"}}\n"
    }
  },
  "steps": [
    {
      "run": [
        "close"
      ],
      "expect": {
        "exit": 2,
        "stderr": [
          "JITSO REJECTED: usage: jitso close <launch_id>"
        ],
        "orca_calls": {
          "empty": true
        }
      }
    },
    {
      "run": [
        "close",
        "L20261113T142233-a3f9",
        "extra"
      ],
      "expect": {
        "exit": 2,
        "stderr": [
          "JITSO REJECTED: usage: jitso close <launch_id>"
        ],
        "orca_calls": {
          "empty": true
        }
      }
    },
    {
      "run": [
        "close",
        "L20261113T142233-a3f9",
        "L20261113T142233-a3f9"
      ],
      "expect": {
        "exit": 2,
        "stderr": [
          "JITSO REJECTED:"
        ],
        "orca_calls": {
          "empty": true
        },
        "registry": {
          "count": 1
        }
      }
    }
  ]
}
