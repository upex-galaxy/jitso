{
  "id": "close/no-terminal-handle",
  "title": "a launch that has no terminal handle in its orca object exits 2 and nothing is written or called",
  "source": [
    "cli/jitso/close.ts: `has no terminal handle` branch (no test in close.test.ts)"
  ],
  "project": {
    "files": {
      ".jitso/launches.jsonl": "{\"v\":2,\"event\":\"launch\",\"id\":\"L20261113T142233-a3f9\",\"parent\":null,\"root\":\"L20261113T142233-a3f9\",\"depth\":0,\"ts\":\"2026-11-13T14:22:33.000Z\",\"mode\":\"direct\",\"build\":\"haiku-explorer\",\"orca\":{{orca_json}}}\n"
    }
  },
  "for_each": {
    "var": "orca_json",
    "values": [
      "{\"run\":null,\"task\":null,\"terminal\":null,\"title\":\"t\"}",
      "{\"terminal\":42}",
      "null",
      "[]"
    ]
  },
  "steps": [
    {
      "run": [
        "close",
        "L20261113T142233-a3f9"
      ],
      "expect": {
        "exit": 2,
        "stderr": [
          "JITSO REJECTED: launch L20261113T142233-a3f9 has no terminal handle"
        ],
        "orca_calls": {
          "empty": true
        },
        "registry": {
          "count": 1
        },
        "files": [
          {
            "path": ".jitso/launches/L20261113T142233-a3f9",
            "exists": false
          }
        ]
      }
    }
  ]
}
