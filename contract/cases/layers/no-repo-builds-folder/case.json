{
  "id": "layers/no-repo-builds-folder",
  "title": "a project with no jitso/builds folder has an empty project layer, and the user layer still works",
  "source": [
    "intended: builds come from layers (repo, trusted parent folders, user folder), nearest wins (docs/decisions.md)"
  ],
  "defect": "N-12",
  "intent": "INTENDED behavior (defect N-12, build layers). A missing jitso/builds folder is an empty project layer, not an error: the user folder's builds are still listed and launchable.",
  "project": {
    "files": {
      ".jitso/briefs/brief.md": {
        "from": "brief.md"
      },
      "jitso/builds": null
    }
  },
  "home": {
    "files": {
      ".jitso/builds/shared-scan.yaml": {
        "from": "shared-scan.yaml"
      }
    }
  },
  "steps": [
    {
      "run": [
        "build",
        "list"
      ],
      "expect": {
        "exit": 0,
        "stderr": [
          {
            "empty": true
          }
        ],
        "stdout": [
          {
            "regex": "^- shared-scan: claude-haiku-5-5 low\\. [^\\n]+ \\(from user ~/\\.jitso/builds/shared-scan\\.yaml\\)\\n$"
          }
        ]
      }
    },
    {
      "run": [
        "launch",
        "--build",
        "shared-scan",
        "--brief",
        "{{PROJECT}}/.jitso/briefs/brief.md",
        "--mode",
        "direct",
        "--dry-run"
      ],
      "expect": {
        "exit": 0,
        "stdout": [
          {
            "contains": "| build shared-scan v1 (user)"
          }
        ]
      }
    }
  ]
}
